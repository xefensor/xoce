{
  "name": "xoce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The website and documentation for Xef's Open Computing Ecosystem.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
