---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
const destination = '/projects/phone/#android-app';
---
<BaseLayout title="Android — Phone plan" description="Phone is XOCE’s planned Android phone app, with an optional Pebble companion. Read the current project plan.">
  <Fragment slot="head"><meta name="robots" content="noindex,follow"/><link rel="canonical" href="/projects/phone/"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><script is:inline>location.replace('/projects/phone/#android-app');</script></Fragment>
  <main id="main" class="wrap android-redirect"><p class="eyebrow">Android · planned</p><h1>Phone for Android</h1><p>Read the plan for the independent Android phone app and its optional Pebble companion.</p><a class="text-link" href={destination}>Open the Phone plan<Icon name="arrow" size={18}/></a></main>
</BaseLayout>
<style>.android-redirect{padding-top:clamp(45px,8vw,90px);max-width:850px}.android-redirect h1{margin-top:16px;font-size:clamp(2.5rem,6vw,4.5rem);line-height:1.1;letter-spacing:-.05em}.android-redirect>p:not(.eyebrow){max-width:52ch;margin-block:24px;color:var(--muted);line-height:1.8}</style>
