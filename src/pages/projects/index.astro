---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sitePath } from '../../lib/site';
import { consumerProjects } from '../../data/projects';
import ProjectCard from '../../components/ProjectCard.astro';
const groups=[{kind:'watchface',title:'Choose your watchface',note:'Your everyday clock screen. Choose Dynamic or Halftone.'},{kind:'app',title:'A few useful tools',note:'Watch apps you open when you need them. All support Time 2 and Round 2.'},{kind:'plugin',title:'A weather source for your phone',note:'ČHMÚ Weather runs inside the Pebble phone app and supplies Czech weather readings.'}];
---
<BaseLayout title="Software" description="Compare XOCE’s two Pebble watchfaces, three watch apps and Czech weather plugin. Find requirements, previews and installation help.">
<main id="main" class="wrap launch-catalogue"><header class="catalogue-intro"><p class="eyebrow">The Pebble collection</p><h1>Make your watch<br/>a little more useful.</h1><p>Choose a clock, add the tools you need, and make room for your own readings and activities.</p><a class="text-link" href={sitePath('/docs/')}>First time here? Start with setup</a></header>
<div id="available-apps">{groups.map(group=><section class="catalogue-group" data-project-group><header><h2>{group.title}</h2><p>{group.note}</p></header><div class="catalogue-grid">{consumerProjects.filter(p=>p.kind===group.kind).map(project=><ProjectCard project={project}/>)}</div></section>)}</div>
<aside class="catalogue-help"><h2>Already installed?</h2><p>Find the controls, change a setting or troubleshoot your connection.</p><a class="text-link" href={sitePath('/docs/')}>Read the guides</a><a class="text-link" href={sitePath('/docs/pebble/troubleshooting/')}>Get help</a></aside>
<section class="developer-path"><h2>Building something for Pebble?</h2><p>Activities and Core are embedded developer libraries, not apps you need to install.</p><a class="text-link" href={sitePath('/docs/develop/building/')}>Build and contribute</a><a class="text-link" href={sitePath('/docs/develop/activities/')}>Activities integration</a><a class="text-link" href={sitePath('/docs/develop/core/')}>Core integration</a></section>
</main></BaseLayout>
