---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Projects" description="Explore the XOCE Pebble apps, watchface and developer libraries, with current downloads and setup guides.">
  <main id="main" class="wrap section page-main"><header class="page-heading"><p class="eyebrow">The XOCE collection</p><h1>The current projects.</h1><p class="lead">Four Pebble apps and watchfaces, plus the two libraries behind them. Find a download, a guide or the source code.</p></header>
    <div class="catalogue-toolbar"><div class="filter-group" aria-label="Filter projects"><button data-project-filter="all" aria-pressed="true">All projects</button><button data-project-filter="apps" aria-pressed="false">Apps & watchfaces</button><button data-project-filter="libraries" aria-pressed="false">Developer tools</button></div><span data-project-count aria-live="polite">6 projects</span></div>
    <div class="project-grid" id="project-list">{projects.map(project => <ProjectCard project={project} />)}</div><p class="image-caption">App previews are native emulator captures with example data. Current apps target Pebble Time 2 development builds.</p>
    <aside class="callout"><Icon name="book" size={25} /><div><h2>New to the collection?</h2><p>You can use the apps individually. The <a href="/docs/pebble/setup/">setup guide</a> explains how Timer, Dynamic and Open Activity work together, and how to start with Dashboard.</p></div></aside>
  </main>
</BaseLayout>
<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-card]')];
  const count = document.querySelector('[data-project-count]');
  filters.forEach(button => button.addEventListener('click', () => { const filter = button.dataset.projectFilter; filters.forEach(other => other.setAttribute('aria-pressed', String(other === button))); let visible = 0; cards.forEach(card => { card.hidden = !(filter === 'all' || (filter === 'libraries' ? card.dataset.projectKind === 'library' : card.dataset.projectKind !== 'library')); if (!card.hidden) visible++; }); if (count) count.textContent = `${visible} project${visible === 1 ? '' : 's'}`; }));
</script>
