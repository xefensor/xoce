---
import { sitePath } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project }
const { project } = Astro.props;
const library = project.kind === 'library';
const planned = project.availability === 'planned';
const companionRedirect = project.slug === 'pebble-phone';
const consumers = projects.filter(item => project.consumers?.includes(item.slug));
const required = projects.filter(item => project.requires?.includes(item.slug));
const releaseHref = project.repo && project.tag ? `${project.repo}/releases/tag/${project.tag}` : undefined;
const appGuides = [
  { href: project.setupGuide, label: 'Install and set up', icon: 'download' },
  { href: project.controlsGuide, label: 'Watch controls', icon: 'watch' },
  { href: project.helpGuide, label: 'Troubleshooting', icon: 'book' },
].filter(item => item.href);
---
<BaseLayout title={project.name} description={project.description}>
  {companionRedirect && <Fragment slot="head"><meta name="robots" content="noindex,follow"/><link rel="canonical" href={sitePath('/projects/phone/')}/><meta http-equiv="refresh" content={`0;url=${sitePath('/projects/phone/#pebble-companion')}`}/><script is:inline>location.replace(document.querySelector('meta[http-equiv="refresh"]').content.replace(/^0;url=/, ''));</script></Fragment>}
  <main id="main" class:list={['wrap', 'product-page', `project-${project.slug}`, { 'library-page': library, 'planned-page': planned }]}>
    {companionRedirect ? <div class="redirect-copy"><p class="eyebrow">Phone · planned</p><h1>Phone for Pebble</h1><p>The Android app and its optional watch companion now share one project plan.</p><a class="text-link" href={sitePath('/projects/phone/#pebble-companion')}>Open the Phone plan<Icon name="arrow" size={18}/></a></div> : <>
      <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href={sitePath(library ? '/docs/' : '/projects/')}>{library ? 'Docs' : 'Software'}</a><Icon name="chevron" size={12}/>{library ? <a href={sitePath('/docs/develop/building/')}>Developers</a> : planned ? <span>Planned</span> : <a href={sitePath('/pebble/')}>PebbleOS</a>}<Icon name="chevron" size={12}/><span aria-current="page">{project.name}</span></nav>
      {planned ? <>
        <header class="phone-intro"><p class="eyebrow">Android · planned</p><h1 id="product-title">Phone</h1><p class="phone-purpose">A phone app for Android.<br/>A watch connection when you want it.</p><p class="plan-status">Phone is a working name. No build is available yet.</p></header>
        <div class="phone-plan">
          <section id="android-app" class="phone-component" aria-labelledby="plan-scope-title"><div class="component-heading"><Icon name="phone" size={29}/><h2 id="plan-scope-title">On Android</h2></div><p>Phone is planned as an independent Android phone app. You would be able to use it without a watch.</p><p>It is the next piece of XOCE’s everyday software, with its own interface and controls on the phone.</p></section>
          <section id="pebble-companion" class="phone-component" aria-labelledby="connections-title"><div class="component-heading"><Icon name="watch" size={29}/><h2 id="connections-title">From your Pebble</h2></div><p>An optional, separately installed watch companion is intended to let you start a call through Phone on Android.</p><p>The companion would require the Android app. Its connection method and supported watches will be established with a test build.</p></section>
        </div>
        <section class="plan-next" aria-labelledby="plan-unknowns-title"><h2 id="plan-unknowns-title">Still being worked out</h2><p>The interface, call controls and setup are not final. This page will hold the actual requirements, screenshots and installation instructions when a build is ready.</p><a class="text-link" href={sitePath('/about/#direction')}>Where this fits in XOCE<Icon name="arrow" size={17}/></a></section>
        <nav class="plan-links" aria-label="Other XOCE work"><a class="text-link" href={sitePath('/projects/')}>Explore current software<Icon name="arrow" size={17}/></a><a class="text-link" href={sitePath('/about/#contribute')}>Help build XOCE<Icon name="code" size={17}/></a></nav>
      </> : <>
        <section class:list={['product-hero', { 'has-screenshot': !!project.image, 'library-product': library }]} aria-labelledby="product-title">
          <div class="product-copy"><p class="product-kind">{library ? 'Pebble developer library' : `PebbleOS · ${project.kind === 'watchface' ? 'Watchface' : 'App'}`}</p><h1 id="product-title">{project.name}</h1><p class="product-purpose">{project.description}</p>
            {library ? <div class="library-start"><a class="button button-primary" href={sitePath(project.guide)}>Integration guide<Icon name="code" size={18}/></a>{project.download && <a class="package-download" href={sitePath(project.download)}>Download package v{project.version}<Icon name="download" size={17}/></a>}<p class="release-status">v{project.version} · {project.status}</p></div> : <div class="download-area">
              {required.length > 0 && <p class="required-apps">Requires {required.map((item, index) => <>{index > 0 && ', '}<a href={sitePath(`/projects/${item.slug}/`)}>{item.name}</a></>)}.</p>}
              <div class="button-row">{project.download && <a class="button button-primary product-download" href={sitePath(project.download)} aria-label={`Download ${project.name} v${project.version}`}>Download v{project.version}<Icon name="download" size={18}/></a>}<a class="text-link" href={sitePath(project.setupGuide ?? project.guide)}>Install and set up<Icon name="arrow" size={17}/></a></div>
              <dl class="project-facts"><div><dt>For</dt><dd>{project.compatibility}</dd></div><div><dt>Release</dt><dd>{project.status}</dd></div></dl>
              {project.requirements && <ul class="requirements">{project.requirements.map(requirement => <li>{requirement}</li>)}</ul>}
            </div>}
          </div>
          {project.image && <div class="product-preview"><ProjectPreview project={project} eager/><p class="preview-caption">{project.name} v{project.imageVersion} · native emulator · example data</p></div>}
        </section>
        <div class="product-information">
          <section class="product-details" aria-labelledby="product-features"><div><h2 id="product-features">{library ? 'What the library provides' : 'On your watch'}</h2><p class="product-summary">{project.summary}</p></div><ul class="feature-list">{project.features.map(feature => <li><Icon name="check" size={18}/><span>{feature}</span></li>)}</ul></section>
          {project.slug === 'timer' && <aside class="timer-connection"><Icon name="watch" size={24}/><p>The countdown can also appear in <a href={sitePath('/projects/dynamic/')}>Dynamic</a> and <a href={sitePath('/projects/dashboard/')}>Dashboard</a>. Timer keeps ownership of the watch alarm.</p></aside>}
          {!library && appGuides.length > 0 && <section class="product-guides" aria-labelledby="product-guides-title"><h2 id="product-guides-title">Use {project.name}</h2><nav aria-label={`${project.name} guides`}>{appGuides.map(guide => <a href={sitePath(guide.href)}><Icon name={guide.icon} size={21}/><span>{guide.label}</span><Icon name="arrow" size={17}/></a>)}</nav></section>}
          {library && consumers.length > 0 && <section class="project-context" aria-labelledby="project-consumers"><div><h2 id="project-consumers">Included in these apps</h2><p>Each app owns its interface and release.</p></div><nav class="project-consumer-links" aria-label={`${project.name} consumers`}>{consumers.map(item => <a href={sitePath(`/projects/${item.slug}/`)}>{item.name}<Icon name="arrow" size={16}/></a>)}</nav></section>}
          {!library && (project.developerNote || project.developerGuide) && <details class="developer-details"><summary id="project-developers">Developer information</summary>{project.developerNote && <p>{project.developerNote}</p>}<nav aria-label={`${project.name} developer resources`}>{project.developerGuide && <a href={sitePath(project.developerGuide)}>Integration guide<Icon name="arrow" size={16}/></a>}<a href={sitePath('/docs/develop/building/')}>Build from source<Icon name="code" size={16}/></a></nav></details>}
          <div class="product-source">{(releaseHref || project.repo) && <nav class="product-resources" aria-label={`${project.name} source and release links`}>{releaseHref && <a href={sitePath(releaseHref)}>Release files & checksums<Icon name="external" size={16}/></a>}{project.repo && <a href={sitePath(project.repo)}>Source & issues<Icon name="code" size={16}/></a>}</nav>}{project.licence && <p class="product-license">Project licence: <a href={sitePath(project.licence.url)}>{project.licence.name}</a>.</p>}</div>
        </div>
      </>}
    </>}
  </main>
</BaseLayout>
<style>
  .product-page { padding-top:30px; }
  .product-breadcrumb { display:flex; align-items:center; flex-wrap:wrap; gap:9px; min-height:44px; color:var(--muted); font-size:.8rem; }
  .product-breadcrumb a { padding-block:9px; text-decoration:none; }
  .product-breadcrumb a:hover { text-decoration:underline; }
  .product-breadcrumb :global(svg) { flex-shrink:0; }
  .product-hero { display:grid; grid-template-columns:minmax(0,1fr); align-items:center; gap:50px; padding-block:40px 54px; }
  .product-hero.has-screenshot { grid-template-columns:minmax(0,1fr) minmax(280px,.7fr); }
  .product-copy { min-width:0; }
  .product-kind { color:var(--accent-text); font-size:.82rem; line-height:1.6; }
  .product-copy h1,.phone-intro h1 { margin-top:18px; font-size:clamp(3.3rem,7vw,6rem); font-weight:600; letter-spacing:-.065em; line-height:1.02; }
  .product-purpose { max-width:25ch; margin-top:25px; font-size:clamp(1.25rem,2.3vw,1.8rem); line-height:1.45; letter-spacing:-.025em; }
  .download-area,.library-start { margin-top:28px; }
  .required-apps { margin-bottom:14px; font-size:.85rem; color:var(--muted); }
  .required-apps a { color:var(--accent-text); }
  .button-row { display:flex; align-items:center; flex-wrap:wrap; gap:12px 24px; }
  .button-row .text-link { font-size:.87rem; }
  .project-facts { display:flex; flex-wrap:wrap; gap:15px 32px; margin-top:27px; }
  .project-facts dt { font-size:.75rem; color:var(--muted); }
  .project-facts dd { margin:5px 0 0; font-size:.86rem; line-height:1.6; font-weight:550; }
  .requirements { max-width:57ch; margin-top:16px; padding-left:17px; color:var(--muted); font-size:.8rem; line-height:1.75; }
  .requirements li + li { margin-top:3px; }
  .product-preview { min-width:0; padding:26px 10px 20px; border:1px solid var(--glass-edge); border-radius:var(--radius-pane); background:var(--glass-feature-surface); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); box-shadow:var(--glass-shadow); }
  .preview-caption { margin-top:13px; color:var(--muted); font-size:.72rem; text-align:center; line-height:1.6; }
  .product-information { border-top:1px solid var(--line); padding-top:36px; }
  .product-information h2 { font-size:clamp(1.5rem,2.5vw,2rem); font-weight:600; letter-spacing:-.035em; line-height:1.2; }
  .product-details { display:grid; grid-template-columns:1fr 1fr; gap:70px; }
  .product-summary { max-width:48ch; margin-top:18px; color:var(--muted); font-size:.98rem; line-height:1.8; }
  .feature-list { list-style:none; margin:0; padding:0; }
  .feature-list li { display:grid; grid-template-columns:18px minmax(0,1fr); align-items:start; gap:13px; padding:15px 0; border-bottom:1px solid var(--line); font-size:.95rem; line-height:1.7; }
  .feature-list li:first-child { padding-top:0; }
  .feature-list li:last-child { border-bottom:0; }
  .feature-list :global(svg) { margin-top:4px; color:var(--accent-text); }
  .timer-connection { display:flex; align-items:start; gap:14px; max-width:70ch; margin-top:25px; color:var(--muted); font-size:.88rem; line-height:1.75; }
  .timer-connection :global(svg) { color:var(--accent-text); flex-shrink:0; margin-top:3px; }
  .timer-connection a { color:var(--ink); }
  .product-guides { margin-top:42px; padding:30px clamp(22px,3vw,36px); border:1px solid var(--glass-edge); border-radius:var(--radius-pane); background:var(--glass-surface); box-shadow:var(--glass-shadow); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); }
  .product-guides h2 { font-size:1.3rem; }
  .product-guides nav { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:20px; }
  .product-guides a { display:grid; grid-template-columns:21px minmax(0,1fr) 17px; align-items:center; gap:12px; min-height:48px; text-decoration:none; font-size:.88rem; }
  .product-guides a > :global(svg:first-child) { color:var(--accent-text); }
  .product-guides a:hover span { text-decoration:underline; }
  .developer-details { margin-top:28px; padding-block:12px; border-bottom:1px solid var(--line); }
  .developer-details summary { width:fit-content; min-height:44px; padding:10px 4px; cursor:pointer; font-size:.86rem; font-weight:550; }
  .developer-details p { max-width:75ch; margin:10px 0; color:var(--muted); font-size:.87rem; line-height:1.75; }
  .developer-details nav,.product-resources { display:flex; flex-wrap:wrap; gap:4px 26px; }
  .developer-details a,.product-resources a,.package-download { display:inline-flex; align-items:center; gap:9px; min-height:44px; padding-block:9px; text-decoration:none; font-size:.82rem; }
  .developer-details a:hover,.product-resources a:hover,.package-download:hover { text-decoration:underline; }
  .product-source { margin-top:22px; color:var(--muted); }
  .product-license { margin-top:8px; font-size:.76rem; line-height:1.7; }
  .library-product { max-width:800px; padding-block:43px; }
  .library-product .product-purpose { max-width:35ch; }
  .library-start { display:flex; align-items:center; flex-wrap:wrap; gap:10px 25px; }
  .release-status { width:100%; color:var(--muted); font-size:.8rem; }
  .project-context { display:grid; grid-template-columns:1fr 1fr; gap:70px; margin-top:35px; padding-top:30px; border-top:1px solid var(--line); }
  .project-context p { margin-top:13px; color:var(--muted); font-size:.9rem; line-height:1.7; }
  .project-consumer-links { display:flex; align-items:start; justify-content:start; flex-wrap:wrap; gap:5px 24px; }
  .project-consumer-links a { display:inline-flex; align-items:center; gap:9px; min-height:44px; font-size:.9rem; text-decoration:none; }
  .project-consumer-links a:hover { text-decoration:underline; }
  .planned-page { max-width:1060px; }
  .phone-intro { padding-block:36px 45px; }
  .phone-purpose { margin-top:26px; font-size:clamp(1.45rem,3.1vw,2.3rem); line-height:1.4; letter-spacing:-.035em; }
  .plan-status { margin-top:22px; color:var(--muted); font-size:.85rem; line-height:1.7; }
  .phone-plan { display:grid; grid-template-columns:1fr 1fr; gap:55px; padding:clamp(24px,4vw,42px); border:1px solid var(--glass-edge); border-radius:var(--radius-pane); background:var(--glass-surface); box-shadow:var(--glass-shadow); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); }
  .component-heading { display:flex; align-items:center; gap:15px; }
  .component-heading :global(svg) { color:var(--accent-text); flex-shrink:0; }
  .component-heading h2 { font-size:1.45rem; line-height:1.3; letter-spacing:-.035em; }
  .phone-component p { max-width:43ch; margin-top:19px; color:var(--muted); font-size:.96rem; line-height:1.8; }
  .phone-component p + p { margin-top:13px; }
  .plan-next { display:grid; grid-template-columns:.75fr 1.25fr; column-gap:55px; row-gap:15px; padding-block:36px; border-bottom:1px solid var(--line); }
  .plan-next h2 { font-size:1.4rem; line-height:1.35; letter-spacing:-.035em; }
  .plan-next p { max-width:56ch; color:var(--muted); font-size:.93rem; line-height:1.8; }
  .plan-next > a { grid-column:2; justify-self:start; font-size:.85rem; }
  .plan-links { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px 30px; margin-top:25px; }
  .plan-links a { font-size:.88rem; }
  .redirect-copy { max-width:720px; padding-block:65px; }
  .redirect-copy h1 { margin-top:15px; font-size:clamp(2.5rem,5vw,4rem); letter-spacing:-.05em; }
  .redirect-copy p:not(.eyebrow) { margin-block:24px; color:var(--muted); line-height:1.75; }
  @media (max-width:850px) {
    .product-hero.has-screenshot { grid-template-columns:minmax(0,1fr) minmax(240px,.7fr); gap:28px; }
    .product-copy h1 { font-size:clamp(3rem,6.7vw,4.5rem); }
    .product-details,.project-context { gap:35px; }
    .product-guides nav { grid-template-columns:minmax(0,1fr); gap:3px; }
    .product-guides a + a { border-top:1px solid var(--line); }
  }
  @media (max-width:650px) {
    .product-page { padding-top:20px; }
    .product-hero,.product-hero.has-screenshot { grid-template-columns:minmax(0,1fr); gap:30px; padding-block:26px 33px; }
    .product-copy h1,.phone-intro h1 { font-size:clamp(3rem,12vw,4.5rem); }
    .product-purpose { max-width:28ch; font-size:1.35rem; margin-top:20px; }
    .product-preview { width:100%; max-width:380px; justify-self:center; }
    .product-details,.project-context { grid-template-columns:minmax(0,1fr); gap:27px; }
    .product-information { padding-top:28px; }
    .product-guides { margin-top:30px; padding:24px 22px; }
    .phone-intro { padding-block:28px 33px; }
    .phone-plan { grid-template-columns:minmax(0,1fr); gap:30px; padding:25px; }
    .phone-component + .phone-component { padding-top:28px; border-top:1px solid var(--line); }
    .phone-component p { font-size:.92rem; }
    .plan-next { grid-template-columns:minmax(0,1fr); gap:17px; padding-block:29px; }
    .plan-next > a { grid-column:1; }
    .plan-links { align-items:start; flex-direction:column; gap:8px; }
  }
</style>
