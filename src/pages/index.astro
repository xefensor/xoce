---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const apps = projects.filter(project => project.kind !== 'library');
---
<BaseLayout>
  <main id="main">
    <section class="home-hero wrap">
      <div class="hero-copy"><p class="eyebrow"><span class="little-line"></span> Xef’s Open Computing Ecosystem</p><h1>New technology.<br /><span>Natural to use.</span></h1><p class="hero-description">Useful apps. Curious experiments. A more thoughtful way to use the technology around you.</p><div class="button-row"><a class="button button-primary" href="/projects/">Explore the projects <Icon name="arrow" size={18} /></a><a class="button button-plain" href="/about/">Meet XOCE <Icon name="external" size={18} /></a></div><p class="hero-note">An independent project. Built around people.</p></div>
      <HeroIllustration />
    </section>
    <section class="principles-strip wrap" aria-label="What guides the work">
      <div><span class="principle-number">01</span><div><h2>Make it feel easy.</h2><p>Good tools give you less to figure out.</p></div></div>
      <div><span class="principle-number">02</span><div><h2>Keep it quick.</h2><p>Time, attention and battery all matter.</p></div></div>
      <div><span class="principle-number">03</span><div><h2>Stay curious.</h2><p>There’s room to do things differently.</p></div></div>
    </section>
    <section class="section wrap" id="available-projects">
      <div class="section-heading"><div><p class="eyebrow">The first collection / Pebble</p><h2>Small screen.<br />Useful things.</h2></div><div class="section-intro"><p>A watchface, a dashboard, a timer and a shortcut that brings them together. Practical software for the watch already on your wrist.</p><a class="text-link" href="/projects/">All projects & developer tools <Icon name="arrow" size={18} /></a></div></div>
      <div class="collection-note"><span class="status-dot"></span><span>Development builds for Pebble Time 2. <a href="/docs/pebble/setup/">Start with the setup guide.</a></span></div>
      <div class="project-grid">{apps.map(project => <ProjectCard project={project} />)}</div>
      <p class="image-caption">Native emulator previews with example data. Watch cases are illustrations.</p>
    </section>
    <section class="lab-feature wrap">
      <div class="lab-feature-copy"><p class="eyebrow">The XOCE Lab</p><h2>A little room<br />to rethink things.</h2><p>What should a desktop feel like? How could an interface get out of your way? The Lab is a place to ask, sketch and try.</p><a class="button button-light" href="/lab/">Step into the Lab <Icon name="arrow" size={18} /></a></div>
      <a class="lab-art" href="/lab/#workspace" aria-label="Try the workspace interaction study"><div class="lab-art-grid"></div><div class="art-window art-window-one"><span>A THOUGHT</span><strong>Make<br />some room.</strong></div><div class="art-window art-window-two"><span>A DIFFERENT ANGLE</span><div class="art-circle"></div></div><div class="art-window art-window-three"><Icon name="arrow" size={35} /><span>TRY THE IDEA</span></div><span class="lab-art-caption">An interaction study. Yours to move around.</span></a>
    </section>
    <section class="section wrap guide-section"><div class="section-heading"><div><p class="eyebrow">A good place to start</p><h2>Find your way in.</h2></div><a class="text-link" href="/docs/">Open the documentation <Icon name="arrow" size={18} /></a></div><div class="guide-grid"><a class="guide-card" href="/docs/pebble/setup/"><Icon name="watch" size={28} /><h3>Make it your watch.</h3><p>Install the apps, choose what you see, and connect the useful parts.</p><span>Set up the Pebble collection <Icon name="arrow" size={17} /></span></a><a class="guide-card" href="/docs/develop/activities/"><Icon name="code" size={28} /><h3>Build something useful.</h3><p>Give an activity its content and actions. Let the host handle the layout.</p><span>Develop an activity <Icon name="arrow" size={17} /></span></a><a class="guide-card" href="/docs/design/principles/"><Icon name="spark" size={28} /><h3>Keep the person in mind.</h3><p>Shared design principles, shaped around the device someone is using.</p><span>Read the design principles <Icon name="arrow" size={17} /></span></a></div></section>
  </main>
</BaseLayout>
