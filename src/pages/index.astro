---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WatchPreview from '../components/WatchPreview.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const apps = projects.filter(project => project.kind !== 'library');
const libraries = projects.filter(project => project.kind === 'library');
const dynamic = projects.find(project => project.slug === 'dynamic')!;
---
<BaseLayout>
  <main id="main">
    <section class="home-hero wrap">
      <div class="hero-copy">
        <p class="eyebrow"><span class="little-line"></span> Xef’s Open Computing Ecosystem</p>
        <h1>Your watch.<br /><span>More useful.</span></h1>
        <p class="hero-description">Apps, a watchface and shared developer tools for Pebble. Find something to use, learn how it works, or build an integration.</p>
        <div class="button-row">
          <a class="button button-primary" href="/users/">Find apps & watchfaces <Icon name="arrow" size={18} /></a>
          <a class="button button-plain" href="/developers/">For developers <Icon name="code" size={18} /></a>
        </div>
        <p class="hero-note">Current development builds for Pebble Time 2.</p>
      </div>
      <figure class="home-product-preview">
        <a class="home-product-link" href="/projects/dynamic/">
          <span class="eyebrow">Dynamic / Pebble watchface</span>
          <WatchPreview image={dynamic.image!} alt="Dynamic’s native emulator screen with the time, weather readings and a music activity." eager />
          <span class="home-product-label">Time, readings and what’s happening now. <Icon name="arrow" size={18} /></span>
        </a>
        <figcaption>Native emulator capture · example data · illustrated watch case</figcaption>
      </figure>
    </section>
    <section class="section wrap home-collection" id="available-projects">
      <div class="section-heading">
        <div><p class="eyebrow">The current collection / PebbleOS</p><h2>Apps for your watch.</h2></div>
        <div class="section-intro"><p>Check your activities, keep a countdown running, or open the app you need from your watchface.</p><a class="text-link" href="/users/">Choose an app & get started <Icon name="arrow" size={18} /></a></div>
      </div>
      <div class="collection-note"><span class="status-dot"></span><span>Four apps and watchfaces. Development prereleases for Pebble Time 2. <a href="/docs/pebble/setup/">Installation & compatibility.</a></span></div>
      <div class="project-grid">{apps.map(project => <ProjectCard project={project} />)}</div>
      <p class="image-caption">Native emulator previews with example data. Watch cases are illustrations.</p>
    </section>
    <section class="section wrap home-developer-section">
      <div class="section-heading">
        <div><p class="eyebrow">For developers</p><h2>Build on the useful parts.</h2></div>
        <div class="section-intro"><p>The libraries behind the apps are available separately. Integrate activity summaries or shared readings into a Pebble project.</p><a class="text-link" href="/developers/">Libraries, integration & source <Icon name="arrow" size={18} /></a></div>
      </div>
      <div class="library-link-grid">{libraries.map(project => <a class="library-link" href={'/projects/' + project.slug + '/'}><Icon name="code" size={29} /><div><span class="eyebrow">Developer library · v{project.version}</span><h3>{project.name}</h3><p>{project.description}</p></div><Icon name="arrow" /></a>)}</div>
    </section>
    <section class="section wrap guide-section">
      <div class="section-heading"><div><p class="eyebrow">Documentation</p><h2>Find what you need.</h2></div><a class="text-link" href="/docs/">Browse all guides <Icon name="arrow" size={18} /></a></div>
      <div class="guide-grid">
        <a class="guide-card" href="/docs/pebble/setup/"><Icon name="watch" size={28} /><h3>Set up your watch.</h3><p>Download the builds, choose your settings and connect the apps you use.</p><span>Installation & setup <Icon name="arrow" size={17} /></span></a>
        <a class="guide-card" href="/docs/pebble/troubleshooting/"><Icon name="book" size={28} /><h3>Get something working.</h3><p>Find help with activities, permissions, app opening and saved settings.</p><span>Troubleshooting <Icon name="arrow" size={17} /></span></a>
        <a class="guide-card" href="/design/"><Icon name="spark" size={28} /><h3>Understand the design.</h3><p>Read the established interface decisions and the website’s visual identity.</p><span>Visual, UI & UX guidance <Icon name="arrow" size={17} /></span></a>
      </div>
    </section>
  </main>
</BaseLayout>
