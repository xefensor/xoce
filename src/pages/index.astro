---
import { sitePath } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import WatchPreview from '../components/WatchPreview.astro';
import { homeWatchPreviews as apps } from '../data/projects';
---
<BaseLayout description="XOCE is a project for everyday software on KDE Plasma, Android and PebbleOS. Try the current Pebble apps and explore the goal of connected tasks across your devices.">
  <main id="main" class="home wrap">
    <section class="home-intro" aria-labelledby="intro-title" data-home-project-intro>
      <div class="intro-copy">
        <p class="eyebrow project-full-name">Xef’s Open Computing Ecosystem</p>
        <h1 id="intro-title">Everyday apps.<br/><span>Built to connect.</span></h1>
        <p class="intro-description">A project for KDE Plasma, Android and PebbleOS. The goal: open-source everyday apps and shared tasks across your desktop, phone and watch.</p>
        <p class="intro-status"><span class="status-dot" aria-hidden="true"></span>Starting with Pebble software.</p>
        <div class="button-row intro-actions"><a class="button button-primary" href={sitePath('/projects/')}>Explore the software <Icon name="arrow" size={18}/></a><a class="text-link" href={sitePath('/about/')}>Why XOCE <Icon name="arrow" size={17}/></a></div>
      </div>
      <fieldset id="current-work" class="watch-showcase glass" data-home-current-work>
        <legend class="sr-only">Preview selected Pebble watch apps</legend>
        <div class="showcase-heading"><span class="eyebrow">On the watch today</span><a href={sitePath('/pebble/')}>Pebble Time 2 <Icon name="arrow" size={14}/></a></div>
        {apps.map((app, index) => <input class="preview-radio sr-only" type="radio" name="watch-preview" id={`preview-${app.slug}`} value={app.slug} checked={index === 0} aria-label={`Preview ${app.name}`} />)}
        <div class="watch-stages">{apps.map((app, index) => <div class="watch-stage" data-watch-preview={app.slug}>
          <WatchPreview image={app.image!} alt={`${app.name} emulator screen in the official Pebble Time 2 frame.`} eager={index === 0}/>
          <div class="watch-stage-caption"><p class="preview-type">{app.kind === 'watchface' ? 'Watchface' : 'Watch app'}</p><h2>{app.name}</h2><p class="preview-type">v{app.imageVersion} · native emulator</p><p class="preview-description">{app.description}</p><a href={sitePath(`/projects/${app.slug}/`)} class="text-link"><span>Explore {app.name}</span><Icon name="arrow" size={16}/></a></div>
        </div>)}</div>
        <div class="watch-choices" aria-label="Choose a screen to preview">{apps.map(app => <label for={`preview-${app.slug}`}>{app.name}</label>)}</div>
        <p class="showcase-note">Emulator screens · official device frame</p>
      </fieldset>
    </section>

    <div class="platform-focus" aria-label="XOCE’s platform focus">
      <p class="platform-intro">Three platforms.<br/><strong>One direction.</strong></p>
      <div><Icon name="monitor" size={23}/><p><span>Desktop</span><strong>KDE Plasma</strong></p></div>
      <div><Icon name="phone" size={23}/><p><span>Phone</span><strong>Android</strong></p></div>
      <div><Icon name="watch" size={23}/><p><span>Watch</span><strong>PebbleOS</strong></p></div>
    </div>

    <section class="current-downloads" aria-labelledby="downloads-title">
      <div><p class="eyebrow">Available now · development builds</p><h2 id="downloads-title">Start on Pebble Time 2.</h2><p>Try a countdown in Timer and follow it on Dynamic. Add Dashboard for an overview, or Open Activity to jump into the app behind an update.</p></div>
      <div class="download-actions"><a class="text-link" href={sitePath('/projects/#available-apps')}>Get the Pebble apps <Icon name="download" size={18}/></a><a class="text-link" href={sitePath('/docs/pebble/setup/')}>Installation and requirements <Icon name="arrow" size={17}/></a><p>Activity features need the Pebble phone app’s plugin preview.</p></div>
    </section>

    <section id="approach" class="connected-section" aria-labelledby="connected-title" data-home-ecosystem>
      <div class="connected-copy"><p class="eyebrow">Where this could lead</p><h2 id="connected-title">One timer.<br/>Whichever device is handy.</h2><p>Set it on your phone. Check it on your watch. Pause it from your computer. One countdown, with the same remaining time everywhere.</p><p class="connection-status">This is a future goal. Today’s apps share activities on the watch; connecting the desktop, phone and watch still lies ahead.</p><a class="text-link" href={sitePath('/about/#connected-devices')}>The idea behind the ecosystem <Icon name="arrow" size={17}/></a></div>
      <figure class="connection-concept glass" aria-label="Future concept: one shared timer available on desktop, phone and watch">
        <div class="concept-top"><span class="eyebrow">Shared timer</span><span class="status-label">Future concept</span></div>
        <div class="shared-timer"><Icon name="clock" size={38}/><strong>One countdown</strong><span>View it. Pause it. Resume it.</span></div>
        <div class="connection-branches" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="connected-devices"><div><Icon name="monitor" size={28}/><span>Desktop</span></div><div><Icon name="phone" size={28}/><span>Phone</span></div><div><Icon name="watch" size={28}/><span>Watch</span></div></div>
        <figcaption>A future connection, not a released feature.</figcaption>
      </figure>
    </section>

    <section class="project-direction" aria-labelledby="direction-title">
      <header><div><p class="eyebrow">Small steps, a wider idea</p><h2 id="direction-title">Start with apps. Build from there.</h2></div><a class="text-link" href={sitePath('/about/#stages')}>Read the project plan <Icon name="arrow" size={17}/></a></header>
      <ol><li><span>01 · Starting here</span><h3>Small, replaceable apps</h3><p>Useful tools and a manageable place to try new ideas.</p></li><li><span>02 · Later</span><h3>Dependable daily software</h3><p>Stable editions, alongside separate interface experiments.</p></li><li><span>03 · Longer term</span><h3>Deeper system work</h3><p>Build further into Android, PebbleOS and the desktop.</p></li></ol>
    </section>

    <section class="home-participate" aria-labelledby="participate-title"><div class="participate-heading"><div><p class="eyebrow">An early project, started by Xef</p><h2 id="participate-title">A useful place to start.</h2></div><p>Try an app, report what gets in your way, or help shape what comes next.</p></div><nav aria-label="Use and contribute"><a href={sitePath('/docs/')}><span><strong>Use the software</strong><small>Set up your watch and try the apps</small></span><Icon name="arrow" size={19}/></a><a href={sitePath('/docs/develop/building/')}><span><strong>Build from source</strong><small>Repositories, libraries and build instructions</small></span><Icon name="arrow" size={19}/></a><a href={sitePath('/about/#contribute')}><span><strong>Help build XOCE</strong><small>Code, design, documentation and bug reports</small></span><Icon name="arrow" size={19}/></a></nav></section>
  </main>
</BaseLayout>
<style>
  .home { padding-bottom: 24px; }
  .home-intro { display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,1fr); gap: clamp(32px,5vw,72px); align-items: center; padding-block: 48px 40px; }
  .project-full-name { color: var(--accent-text); }
  .intro-copy h1 { margin-top: 20px; font-size: clamp(2.8rem,4.6vw,4.2rem); line-height: 1.08; letter-spacing: -.055em; font-weight: 600; }
  .intro-copy h1 span { color: var(--accent-text); }
  .intro-description { max-width: 43ch; margin-top: 23px; font-size: 1.125rem; color: var(--muted); line-height: 1.75; }
  .intro-status { display: flex; align-items: center; gap: 10px; margin-top: 20px; font-size: .875rem; }
  .intro-actions { margin-top: 25px; gap: 8px 22px; }
  .watch-showcase { min-width: 0; margin: 0; padding: 19px 22px 14px; background: var(--glass-feature-surface); }
  .showcase-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2px 12px; }
  .showcase-heading .eyebrow { font-size: .75rem; }
  .showcase-heading > a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; font-size: .75rem; text-decoration: none; color: var(--muted); }
  .showcase-heading > a:hover { text-decoration: underline; }
  .watch-stage { display: none; grid-template-columns: minmax(0,1.18fr) minmax(0,1fr); gap: 18px; align-items: center; padding-block: 13px 17px; }
  .watch-stage :global(.watch-preview) { --watch-width: 244px; margin-inline: auto; }
  #preview-dynamic:checked ~ .watch-stages [data-watch-preview='dynamic'], #preview-dashboard:checked ~ .watch-stages [data-watch-preview='dashboard'], #preview-timer:checked ~ .watch-stages [data-watch-preview='timer'], #preview-open-activity:checked ~ .watch-stages [data-watch-preview='open-activity'] { display: grid; }
  .watch-stage-caption { min-width: 0; }
  .preview-type { color: var(--muted); font-size: .6875rem; }
  .watch-stage-caption h2 { margin-top: 8px; font-size: clamp(1.125rem,1.8vw,1.5rem); letter-spacing: -.035em; }
  .preview-description { margin-top: 11px; color: var(--muted); font-size: .875rem; line-height: 1.7; }
  .watch-stage-caption .text-link { display: flex; width: fit-content; max-width: 100%; gap: 7px; margin-top: 15px; font-size: .75rem; color: var(--accent-text); }
  .watch-stage-caption .text-link > span { min-width: 0; }
  .watch-choices { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 4px; padding-top: 11px; border-top: 1px solid var(--line); }
  .watch-choices label { display: flex; justify-content: center; align-items: center; padding: 8px 6px; min-height: 42px; font-size: .8125rem; cursor: pointer; border-radius: var(--radius-control); border: 1px solid transparent; color: var(--muted); }
  .watch-choices label:hover { background: var(--glass-hover); color: var(--ink); }
  #preview-dynamic:checked ~ .watch-choices [for='preview-dynamic'], #preview-dashboard:checked ~ .watch-choices [for='preview-dashboard'], #preview-timer:checked ~ .watch-choices [for='preview-timer'], #preview-open-activity:checked ~ .watch-choices [for='preview-open-activity'] { background: var(--glass-field); color: var(--accent-text); border-color: var(--line); font-weight: 600; }
  #preview-dynamic:focus-visible ~ .watch-choices [for='preview-dynamic'], #preview-dashboard:focus-visible ~ .watch-choices [for='preview-dashboard'], #preview-timer:focus-visible ~ .watch-choices [for='preview-timer'], #preview-open-activity:focus-visible ~ .watch-choices [for='preview-open-activity'] { outline: 2px solid var(--focus); outline-offset: 1px; }
  .showcase-note { margin-top: 10px; color: var(--muted); text-align: center; font-size: .6875rem; line-height: 1.5; }
  .platform-focus { display: grid; grid-template-columns: 1.12fr repeat(3,1fr); align-items: center; padding-block: 21px; border-block: 1px solid var(--line); }
  .platform-intro { color: var(--muted); font-size: .8125rem; line-height: 1.65; }
  .platform-intro strong { color: var(--ink); font-weight: 550; }
  .platform-focus > div { display: flex; align-items: center; justify-content: center; gap: 13px; border-left: 1px solid var(--line); }
  .platform-focus :global(svg) { color: var(--muted); }
  .platform-focus > div p { display: flex; flex-direction: column; gap: 2px; }
  .platform-focus span { font-size: .75rem; color: var(--muted); }.platform-focus > div strong { font-size: .875rem; font-weight: 550; }
  .current-downloads { display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,1fr); align-items: center; gap: clamp(32px,5vw,72px); padding-block: 35px 40px; }
  .current-downloads h2 { margin-top: 10px; font-size: 1.65rem; }
  .current-downloads p:not(.eyebrow) { max-width: 57ch; margin-top: 12px; color: var(--muted); font-size: .9375rem; line-height: 1.75; }
  .download-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
  .download-actions .text-link { font-size: .875rem; color: var(--accent-text); }
  .current-downloads .download-actions p { max-width: 43ch; font-size: .75rem; margin-top: 6px; }
  .connected-section { display: grid; grid-template-columns: minmax(0,1.12fr) minmax(0,1fr); align-items: center; gap: clamp(32px,5vw,72px); padding-block: 49px; border-top: 1px solid var(--line); }
  .connected-copy h2 { margin-top: 15px; font-size: clamp(1.9rem,2.9vw,2.6rem); line-height: 1.16; font-weight: 600; letter-spacing: -.045em; }
  .connected-copy p:not(.eyebrow) { max-width: 45ch; margin-top: 19px; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .connected-copy p.connection-status { font-size: .875rem; }
  .connected-copy .text-link { margin-top: 13px; color: var(--accent-text); font-size: .875rem; }
  .connection-concept { padding: 20px 25px 18px; }.concept-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; align-items: center; }
  .status-label { border: 1px solid var(--line); border-radius: var(--radius-small); padding: 3px 8px; color: var(--muted); font-size: .6875rem; }
  .shared-timer { display: flex; flex-direction: column; align-items: center; padding-top: 27px; }.shared-timer :global(svg) { color: var(--accent-text); }.shared-timer strong { margin-top: 13px; font-size: 1.35rem; font-weight: 550; letter-spacing: -.025em; }.shared-timer span { margin-top: 6px; color: var(--muted); font-size: .8125rem; }
  .connection-branches { display: grid; grid-template-columns: repeat(3,1fr); margin: 22px auto 0; width: 80%; height: 36px; position: relative; }.connection-branches::before { content: ''; position: absolute; left: 50%; top: 0; height: 15px; width: 1px; background: var(--line); }.connection-branches span { border-top: 1px solid var(--line); margin-top: 15px; position: relative; }.connection-branches span::before { content: ''; position: absolute; left: 50%; top: 0; width: 1px; height: 20px; background: var(--line); }.connection-branches span:first-child { margin-left: 50%; }.connection-branches span:first-child::before { left: 0; }.connection-branches span:last-child { margin-right: 50%; }.connection-branches span:last-child::before { left: 100%; }
  .connected-devices { display: grid; grid-template-columns: repeat(3,1fr); width: 80%; margin: 0 auto; }.connected-devices > div { display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 9px; }.connected-devices span { font-size: .75rem; color: var(--muted); }
  .connection-concept figcaption { text-align: center; margin: 23px auto 0; color: var(--muted); font-size: .6875rem; line-height: 1.6; }
  .project-direction { padding-block: 39px 43px; border-top: 1px solid var(--line); }
  .project-direction header { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 12px 30px; }
  .project-direction h2 { margin-top: 12px; font-size: 1.8rem; line-height: 1.2; }.project-direction .text-link { color: var(--accent-text); font-size: .875rem; }
  .project-direction ol { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 32px; list-style: none; padding: 0; margin: 29px 0 0; }
  .project-direction li { padding-top: 17px; border-top: 1px solid var(--line); }.project-direction li:first-child { border-color: var(--accent); }
  .project-direction li > span { font-size: .75rem; color: var(--muted); font-variant-numeric: tabular-nums; }.project-direction li:first-child > span { color: var(--accent-text); }
  .project-direction h3 { margin-top: 11px; font-size: 1rem; letter-spacing: -.02em; }.project-direction li p { max-width: 34ch; margin-top: 9px; font-size: .875rem; color: var(--muted); line-height: 1.7; }
  .home-participate { padding-block: 35px 8px; border-top: 1px solid var(--line); }
  .participate-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; }.home-participate h2 { font-size: 2rem; margin-top: 12px; }.participate-heading > p { max-width: 37ch; color: var(--muted); font-size: .9375rem; line-height: 1.8; }
  .home-participate nav { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 32px; margin-top: 25px; }
  .home-participate nav > a { display: flex; justify-content: space-between; gap: 14px; align-items: center; text-decoration: none; border-block: 1px solid var(--line); padding-block: 17px; }
  .home-participate strong { display: block; font-size: .9375rem; font-weight: 550; }.home-participate small { display: block; margin-top: 5px; font-size: .75rem; color: var(--muted); line-height: 1.65; }.home-participate nav > a:hover strong { text-decoration: underline; }.home-participate nav :global(svg) { color: var(--accent-text); }
  @media (max-width: 1050px) { .home-intro { gap: 30px; }.intro-copy h1 { font-size: clamp(2.5rem,4.5vw,3rem); }.watch-showcase { padding-inline: 17px; }.watch-stage { gap: 12px; }.preview-description { font-size: .8125rem; }.platform-focus { grid-template-columns: repeat(3,1fr); }.platform-intro { display: none; }.platform-focus > div:first-of-type { border-left: 0; } }
  @media (max-width: 760px) {
    .home-intro { grid-template-columns: minmax(0,1fr); padding-block: 29px 28px; gap: 27px; }.intro-copy h1 { font-size: clamp(2.25rem,7vw,3.4rem); margin-top: 17px; }.intro-description { margin-top: 18px; max-width: 47ch; font-size: 1rem; line-height: 1.7; }.intro-status { margin-top: 16px; font-size: .8125rem; }.intro-actions { margin-top: 19px; gap: 3px 20px; }
    .watch-showcase { width: 100%; max-width: 500px; justify-self: center; padding: 13px 16px 12px; }.watch-stage { grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); gap: 17px; padding-block: 10px 15px; }.watch-stage :global(.watch-preview) { --watch-width: 180px; }.watch-stage-caption h2 { font-size: 1.1875rem; }.preview-description { font-size: .8125rem; }.watch-stage-caption .text-link { font-size: .75rem; margin-top: 10px; }.watch-choices label { font-size: .75rem; }
    .platform-focus { padding-block: 17px; }.platform-focus > div { flex-direction: column; gap: 7px; text-align: center; }.platform-focus > div strong { font-size: .8125rem; }.platform-focus span { font-size: .6875rem; }
    .current-downloads { grid-template-columns: minmax(0,1fr); gap: 17px; padding-block: 28px 31px; }.current-downloads h2 { font-size: 1.5rem; }.current-downloads p:not(.eyebrow) { font-size: .875rem; }
    .connected-section { grid-template-columns: minmax(0,1fr); gap: 24px; padding-block: 33px; }.connected-copy h2 { font-size: 2rem; }.connected-copy p:not(.eyebrow) { margin-top: 16px; font-size: .9375rem; }.connected-copy .text-link { font-size: .8125rem; }.connection-concept { padding: 19px; }.connected-devices,.connection-branches { width: 90%; }
    .project-direction { padding-block: 31px; }.project-direction h2 { font-size: 1.65rem; }.project-direction ol { grid-template-columns: minmax(0,1fr); gap: 19px; margin-top: 23px; }.project-direction li { display: grid; grid-template-columns: minmax(0,.7fr) minmax(0,1.3fr); gap: 7px 20px; padding-top: 16px; }.project-direction li > span { grid-row: 1 / 3; }.project-direction h3 { margin-top: 0; }.project-direction li p { grid-column: 2; margin-top: 0; font-size: .8125rem; }
    .home-participate { padding-block: 29px 0; }.participate-heading { align-items: start; flex-direction: column; gap: 14px; }.home-participate h2 { font-size: 1.75rem; }.participate-heading > p { max-width: 45ch; font-size: .875rem; }.home-participate nav { grid-template-columns: minmax(0,1fr); gap: 0; margin-top: 20px; }.home-participate nav > a { padding-block: 15px; border-top: 0; }.home-participate nav > a:first-child { border-top: 1px solid var(--line); }.home-participate small { font-size: .8125rem; }
  }
  @media (max-width: 480px) {
    .watch-stage { grid-template-columns: minmax(0,1fr); gap: 9px; }
    .watch-stage :global(.watch-preview) { --watch-width: 244px; }
    .watch-stage-caption { text-align: center; }
    .watch-stage-caption h2 { margin-top: 4px; }
    .preview-description { max-width: 34ch; margin: 7px auto 0; }
    .watch-stage-caption .text-link { margin-inline: auto; }
  }
  @media (max-width: 380px) { .project-full-name { font-size: .75rem; }.watch-stage { gap: 12px; }.preview-description { font-size: .75rem; line-height: 1.65; }.project-direction li { grid-template-columns: minmax(0,.6fr) minmax(0,1.4fr); gap: 7px 14px; } }
</style>
