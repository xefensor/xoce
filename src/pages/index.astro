---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/site';
import { consumerProjects } from '../data/projects';
import WatchPreview from '../components/WatchPreview.astro';
import ProductCollection from '../components/ProductCollection.astro';
import Icon from '../components/Icon.astro';
import ActivityExplainer from '../components/ActivityExplainer.astro';
const halftone=consumerProjects.find(p=>p.slug==='halftone')!;
---
<BaseLayout description="Watchfaces, timers and useful shortcuts for Pebble Time 2 and Round 2. Explore XOCE’s apps, see both watch shapes and find setup help.">
<main id="main" class="wrap launch-home">
  <section class="launch-hero" aria-labelledby="home-title">
    <div class="hero-copy"><p class="eyebrow">Pebble apps by Xef</p><h1 id="home-title">Apps for your Pebble.</h1><p class="hero-description">Watchfaces, timers and small tools. Choose what you need.</p><div class="button-row"><a class="button button-primary" href={sitePath('/projects/')}>Explore the apps<Icon name="arrow" size={20}/></a><a class="text-link" href={sitePath('/docs/')}>Get set up</a></div><p class="hero-compatibility">For Pebble Time 2 and Round 2</p></div>
    <div class="hero-showcase"><div class="hero-pair" aria-label="Two watchfaces, two watch shapes">
      <div class="hero-watch"><WatchPreview image="/images/screenshots/dynamic-1.0.0-20261114-emery-four-split.png" alt="Dynamic on Time 2: four readings with split colours." eager/><a href={sitePath('/projects/dynamic/')}><strong>Dynamic</strong><span>Time 2</span></a></div>
      <div class="hero-watch hero-round"><WatchPreview image={halftone.previews!.gabbro!.image} alt={halftone.previews!.gabbro!.alt} platform="gabbro" eager/><a href={sitePath('/projects/halftone/')}><strong>Halftone</strong><span>Round 2</span></a></div>
    </div>
      <p class="hero-evidence">Native emulator previews · example data</p>
    </div>
  </section>
  <ProductCollection/>
  <ActivityExplainer/>

  <section class="home-help"><div><p class="eyebrow">Start here</p><h2>Your watch, your phone,<br/>then your apps.</h2><p>The official Pebble phone app handles pairing, installation and settings. Start with Timer on its own or choose a watchface, then add the connections you want. There’s no separate XOCE app or library to install.</p><a class="text-link" href={sitePath('/pebble/')}>What you need for Pebble<Icon name="arrow" size={17}/></a></div><div><p class="eyebrow">Made by Xef</p><h2>Small apps.<br/>A wider idea.</h2><p>XOCE is Xef’s independent software project. These Pebble apps are the starting point; the longer-term direction includes Android and KDE Plasma.</p><a class="text-link" href={sitePath('/about/')}>About XOCE<Icon name="arrow" size={17}/></a></div></section>
</main>
</BaseLayout>
