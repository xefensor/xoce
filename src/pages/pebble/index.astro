---
import { sitePath } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WatchPreview from '../../components/WatchPreview.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import AppChooser from '../../components/AppChooser.astro';
import PebbleBasics from '../../components/PebbleBasics.astro';
import WatchButtonGuide from '../../components/WatchButtonGuide.astro';
const timer = projects.find(project => project.slug === 'timer')!;
---
<BaseLayout title="Pebble apps" description="Two watchfaces, Dashboard, Timer, activity shortcuts and a Czech weather plugin. See how they work together and check what you need to install them.">
  <main id="main" class="wrap pebble-page">
    <section class="pebble-hero" aria-labelledby="pebble-title"><div class="pebble-intro"><p class="eyebrow">PebbleOS</p><h1 id="pebble-title">For your Pebble.</h1><p class="pebble-purpose">Follow your activities, reach your shortcuts and keep a timer on your wrist.</p><div class="pebble-actions"><a class="button button-primary" href={sitePath('/projects/?platform=PebbleOS#available-apps')}>Browse downloads<Icon name="download" size={18}/></a><a class="text-link" href={sitePath('/docs/pebble/setup/')}>Install and set up<Icon name="arrow" size={17}/></a></div><p class="pebble-support">Watch builds target <strong>Pebble Time 2</strong>. The optional ČHMÚ Weather plugin runs on your phone.</p></div><div class="pebble-device"><WatchPreview image={timer.image!} alt="Timer’s running countdown in the official Pebble Time 2 frame." caption="Timer · native emulator screen" eager/></div></section>
    <PebbleBasics />
    <AppChooser />
    <section class="watch-requirements" aria-labelledby="requirements-title"><header><p class="eyebrow">Compatibility</p><h2 id="requirements-title">Before you install</h2></header><dl><div><dt>Your watch</dt><dd>Pebble Time 2. These builds do not include other Pebble models.</dd></div><div><dt>Your phone</dt><dd>Connected features use the official Pebble phone app’s plugin preview. Music and notification previews need Android; they are unavailable on iPhone in these releases.</dd></div><div><dt>Your downloads</dt><dd>Watch development builds and release candidates, plus a separately installed phone plugin. <a href={sitePath('/docs/pebble/setup/#before-installing')}>Follow the installation steps.</a></dd></div></dl></section>
    <section class="watch-basics-section" id="watch-buttons" aria-labelledby="watch-buttons-title"><div><p class="eyebrow">Your watch’s controls</p><h2 id="watch-buttons-title">Four buttons. A few useful habits.</h2><p>Press Select from your watchface to open the app list. Up and Down move through a list; Select opens an item. Back returns to the previous screen.</p><p>A <strong>watchface</strong> is your clock screen. A <strong>watch app</strong> is something you open. <strong>Quick Launch</strong> assigns an app to a button shortcut.</p><a class="text-link" href={sitePath('/docs/pebble/controls/')}>See each app’s controls<Icon name="arrow" size={17}/></a></div><WatchButtonGuide /></section>
    <section class="terms-section" id="readings-and-activities" aria-labelledby="terms-title"><header><p class="eyebrow">What you see on screen</p><h2 id="terms-title">Readings, activities and plugins.</h2></header><dl><div><dt>A reading</dt><dd>A small piece of information, such as 13°C. Pebble’s phone app calls these Complications.</dd></div><div><dt>An activity</dt><dd>Something happening now, such as a running timer or a song. Dynamic shows a main activity and a smaller secondary row.</dd></div><div><dt>A plugin</dt><dd>Code running in the Pebble phone app that supplies information or actions. Some are built in; others are installed separately.</dd></div></dl><p>The screens use example data. Music needs Android, weather needs a configured source, and a smart-light pin needs an appropriate smart-home plugin.</p></section>
    <section class="watch-connections" aria-labelledby="choose-title"><div><p class="eyebrow">The collection</p><h2 id="choose-title">Use the pieces that help you.</h2></div><div class="connection-copy"><p><a href={sitePath('/projects/timer/')}>Timer</a> owns its countdown and alarm on the watch. With the phone connection, it can share the countdown with <a href={sitePath('/projects/dynamic/')}>Dynamic</a> on your watchface or <a href={sitePath('/projects/dashboard/')}>Dashboard</a> in a watch app.</p><p><a href={sitePath('/projects/open-activity/')}>Open Activity</a> adds a Quick Launch shortcut to the app behind an activity shown by Dynamic. You choose shortcuts for the main and secondary activity.</p><a class="text-link" href={sitePath('/projects/#available-apps')}>Compare the software<Icon name="arrow" size={17}/></a></div></section>
    <section class="watch-connections" aria-labelledby="weather-choice-title"><div><p class="eyebrow">Another look. A local weather source.</p><h2 id="weather-choice-title">Make the clock yours.</h2></div><div class="connection-copy"><p><a href={sitePath('/projects/halftone/')}>Halftone</a> is an alternative to Dynamic, with a dotted border, a bold clock and two readings. Its released 1.9.0-rc.6 candidate shows music and optional notifications, but does not show Timer activities or use Open Activity.</p><p><a href={sitePath('/projects/chmu-weather/')}>ČHMÚ Weather</a> supplies nearby Czech station observations and forecasts. It runs inside the Pebble phone app and can feed Pebble Weather or readings in Dynamic, Halftone and Dashboard. You can use either watchface with another weather source too.</p></div></section>
    <nav class="watch-help" aria-label="Pebble help"><a href={sitePath('/docs/pebble/controls/')}><Icon name="watch" size={25}/><span><strong>Learn the controls</strong><small>What each press and hold does.</small></span><Icon name="arrow" size={18}/></a><a href={sitePath('/docs/pebble/troubleshooting/')}><Icon name="book" size={25}/><span><strong>Fix a problem</strong><small>Activities, settings and Quick Launch.</small></span><Icon name="arrow" size={18}/></a></nav>
    <aside class="planned-watch"><div><p class="eyebrow">Planned</p><h2>Calls from your watch.</h2><p>An optional companion for Phone on Android is intended to let you start a call from Pebble.</p></div><a class="text-link" href={sitePath('/projects/phone/#pebble-companion')}>Read the Phone plan<Icon name="arrow" size={17}/></a></aside>
    <p class="developer-link">Building a plugin? <a href={sitePath('/docs/develop/activities/')}>Read the activity provider guide.</a></p>
  </main>
</BaseLayout>
<style>
  .pebble-page { padding-top:clamp(28px,4.5vw,54px); }
  .watch-basics-section { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:45px; padding-block:35px; scroll-margin-top:90px; } .watch-basics-section h2,.terms-section h2 { margin-top:12px; font-size:clamp(1.6rem,2.6vw,2.2rem); line-height:1.25; letter-spacing:-.035em; } .watch-basics-section p:not(.eyebrow),.terms-section > p { margin-top:17px; color:var(--muted); font-size:.95rem; line-height:1.8; } .watch-basics-section .text-link { margin-top:15px; font-size:.85rem; }
  .terms-section { border-block:1px solid var(--line); padding-block:32px; scroll-margin-top:90px; } .terms-section dl { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:30px; margin-top:25px; } .terms-section dt { font-weight:600; } .terms-section dd { margin:12px 0 0; color:var(--muted); font-size:.9rem; line-height:1.8; }
  @media(max-width:650px) { .watch-basics-section { grid-template-columns:1fr; gap:8px; } .terms-section dl { grid-template-columns:1fr; gap:23px; } }
  .pebble-hero { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr); align-items:center; gap:65px; padding-block:15px 55px; }
  .pebble-intro h1 { max-width:9ch; margin-top:18px; font-size:clamp(3.2rem,7.5vw,6.3rem); font-weight:600; line-height:1.02; letter-spacing:-.065em; }
  .pebble-purpose { max-width:30ch; margin-top:26px; font-size:clamp(1.2rem,2.2vw,1.6rem); line-height:1.55; letter-spacing:-.02em; }
  .pebble-actions { display:flex; align-items:center; flex-wrap:wrap; gap:12px 23px; margin-top:30px; }
  .pebble-actions .text-link { font-size:.86rem; }
  .pebble-support { max-width:47ch; margin-top:24px; color:var(--muted); font-size:.8rem; line-height:1.75; }
  .pebble-support strong { color:var(--ink); font-weight:550; }
  .pebble-device { display:flex; align-items:center; justify-content:center; min-width:0; padding-block:20px; }
  .watch-requirements { padding:clamp(25px,4vw,42px); border:1px solid var(--glass-edge); border-radius:var(--radius-pane); background:var(--glass-surface); box-shadow:var(--glass-shadow); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); }
  .watch-requirements h2 { margin-top:12px; font-size:clamp(1.7rem,2.8vw,2.3rem); line-height:1.2; letter-spacing:-.045em; }
  .watch-requirements dl { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:36px; margin-top:28px; }
  .watch-requirements dt { font-size:.92rem; font-weight:600; }
  .watch-requirements dd { margin:10px 0 0; color:var(--muted); font-size:.87rem; line-height:1.8; }
  .watch-connections { display:grid; grid-template-columns:1fr 1fr; gap:70px; padding-block:55px 40px; }
  .watch-connections h2 { max-width:14ch; margin-top:14px; font-size:clamp(1.9rem,3vw,2.6rem); line-height:1.15; letter-spacing:-.05em; }
  .connection-copy > p { color:var(--muted); font-size:.97rem; line-height:1.85; }
  .connection-copy > p + p { margin-top:19px; }
  .connection-copy p a { color:var(--ink); }
  .connection-copy > a { margin-top:16px; font-size:.86rem; }
  .watch-help { display:grid; grid-template-columns:1fr 1fr; gap:40px; padding-block:25px; border-block:1px solid var(--line); }
  .watch-help > a { display:grid; grid-template-columns:25px minmax(0,1fr) 18px; align-items:center; gap:17px; min-height:70px; padding-block:12px; text-decoration:none; }
  .watch-help > a > :global(svg:first-child) { color:var(--accent-text); }
  .watch-help strong,.watch-help small { display:block; }
  .watch-help strong { font-size:1rem; font-weight:550; }
  .watch-help small { margin-top:8px; color:var(--muted); font-size:.84rem; line-height:1.7; }
  .watch-help a:hover strong { text-decoration:underline; }
  .planned-watch { display:flex; align-items:center; justify-content:space-between; gap:35px; margin-top:37px; }
  .planned-watch h2 { margin-top:10px; font-size:1.4rem; line-height:1.3; letter-spacing:-.035em; }
  .planned-watch p:not(.eyebrow) { max-width:62ch; margin-top:12px; color:var(--muted); font-size:.9rem; line-height:1.75; }
  .planned-watch > a { flex-shrink:0; font-size:.85rem; }
  .developer-link { margin-top:29px; padding-top:23px; border-top:1px solid var(--line); color:var(--muted); font-size:.83rem; line-height:1.7; }
  @media (max-width:850px) {
    .pebble-hero { gap:30px; grid-template-columns:minmax(0,1fr) minmax(240px,.8fr); }
    .watch-requirements dl { gap:25px; }
    .watch-connections { gap:35px; }
    .planned-watch { align-items:start; flex-direction:column; gap:10px; }
  }
  @media (max-width:650px) {
    .pebble-hero { grid-template-columns:minmax(0,1fr); gap:21px; padding-bottom:32px; }
    .pebble-intro h1 { max-width:12ch; font-size:clamp(3rem,12vw,4.3rem); }
    .pebble-purpose { margin-top:22px; font-size:1.2rem; }
    .pebble-actions { margin-top:24px; }
    .pebble-device { padding-block:12px 5px; }
    .watch-requirements { padding:25px; }
    .watch-requirements dl { grid-template-columns:minmax(0,1fr); gap:23px; margin-top:24px; }
    .watch-requirements dd { margin-top:6px; }
    .watch-connections { grid-template-columns:minmax(0,1fr); gap:25px; padding-block:36px 28px; }
    .watch-help { grid-template-columns:minmax(0,1fr); gap:0; padding-block:12px; }
    .watch-help > a + a { border-top:1px solid var(--line); }
    .planned-watch { margin-top:28px; }
  }
</style>
