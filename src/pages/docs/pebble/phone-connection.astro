---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const destination = '/projects/phone/#pebble-companion';
const fragments = { 'what-you-would-need': '/projects/phone/#pebble-companion', 'availability-and-setup': '/projects/phone/#plan-unknowns-title' };
---
<BaseLayout title="Phone companion plan" description="Phone’s optional Pebble companion is described with the Android app plan.">
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={destination} />
    <meta name="phone-plan-destination" content={destination} data-fragments={JSON.stringify(fragments)} />
    <script is:inline>
      const config = document.querySelector('meta[name="phone-plan-destination"]');
      const fragments = JSON.parse(config.dataset.fragments);
      location.replace(Object.hasOwn(fragments, location.hash.slice(1)) ? fragments[location.hash.slice(1)] : config.content);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
  </Fragment>
  <main id="main" class="wrap page-main page-intro">
    <h1>Phone’s companion plan has moved</h1>
    <p><a href={destination}>Read about the optional Pebble companion.</a></p>
  </main>
</BaseLayout>
