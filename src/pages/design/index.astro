---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
const guides = [
  { title: 'Principles', icon: 'spark', href: '/docs/design/principles/', description: 'The established choices behind readable content, predictable actions and restrained motion.', action: 'Read the principles' },
  { title: 'Visual identity', icon: 'grid', href: '/docs/design/visual-identity/', description: 'The current website’s wordmark, colours, typography and assets, with their actual scope.', action: 'Explore the website styling' },
  { title: 'UI patterns', icon: 'watch', href: '/docs/design/ui-patterns/', description: 'Activity layouts, contextual button bars and settings patterns from the Pebble projects.', action: 'See the existing patterns' },
  { title: 'UX & interaction', icon: 'arrow', href: '/docs/design/interaction/', description: 'How navigation, actions, saving, empty states and app transitions behave.', action: 'Understand the interaction' },
];
const examples = [
  { name: 'Dynamic', href: '/projects/dynamic/', image: '/images/projects/dynamic.png', alt: 'Dynamic showing its clock and weather above a music title, album art and artist footer.', detail: 'Content sits above its context. The media title and artwork/artist footer form one readable activity.' },
  { name: 'Dashboard', href: '/projects/dashboard/', image: '/images/projects/dashboard.png', alt: 'Dashboard with a selected timer activity, a Signal notification, weather and phone battery, beside a right-hand action bar.', detail: 'A focused overview combines an activity, a notification and two pins. The action bar follows the selection.' },
  { name: 'Timer', href: '/projects/timer/', image: '/images/projects/timer.png', alt: 'Timer showing the local time, a large 20-second countdown, a blue hourglass and a pause action.', detail: 'A stable countdown and hourglass carry the state. Available actions sit beside the physical buttons.' },
];
---
<BaseLayout title="Design" description="Published XOCE interfaces and the shared UI and UX implemented in local Pebble watchapp and phone settings candidates.">
  <main id="main" class="wrap section page-main">
    <header class="page-heading"><p class="eyebrow">Design</p><h1>Visuals, interfaces<br />and interaction.</h1><p class="lead">The shared UI is implemented and validated in local app candidates. They have not been published. Explore the standard and its verification boundaries; existing screenshots keep their published-build context.</p></header>
    <a class="getting-started-banner" href="/docs/design/pebble-ui-system/">
      <div class="banner-icon"><Icon name="watch" size={28}/></div>
      <div><span class="eyebrow">Validated locally · not published</span><h2>One shared Pebble experience.</h2><p>Watch layouts, phone appearance and confirmed Save feedback across the local candidates.</p></div>
      <Icon name="arrow" size={24}/>
    </a>
    <div class="guide-grid design-guides">{guides.map(guide => <a class="guide-card" href={guide.href}><Icon name={guide.icon} size={28}/><h2>{guide.title}</h2><p>{guide.description}</p><span>{guide.action} <Icon name="arrow" size={17}/></span></a>)}</div>
    <section class="design-examples" aria-labelledby="design-examples-title">
      <div class="section-heading"><div><p class="eyebrow">Published Pebble examples</p><h2 id="design-examples-title">The patterns in use.</h2></div><p class="lead">Shared principles take different forms on a watchface, an overview and a focused app.</p></div>
      <div class="design-example-grid">{examples.map(example => <article class="design-example"><a href={example.href} class="design-example-image"><img src={example.image} alt={example.alt} width="200" height="228" loading="lazy" decoding="async"/></a><div><h3><a href={example.href}>{example.name}</a></h3><p>{example.detail}</p></div></article>)}</div>
      <p class="image-caption">Native emulator captures with example data. Dashboard’s unchanged watch layout is shown using its 0.4.1 capture; the current release is 0.4.3. These images do not establish physical-watch testing.</p>
    </section>
    <aside class="callout"><Icon name="book" size={25}/><div><h2>Published examples and local implementations.</h2><p>The shared standard records local adoption and passed automated, packaged browser and native emulator checks. Real-device verification remains separate. Older screenshots keep their original versions; public download links still point to published builds. The visual identity guide describes this website. Project-specific setup and controls remain in the <a href="/users/">user guides</a>, while API contracts belong in the <a href="/developers/">developer guides</a>.</p></div></aside>
  </main>
</BaseLayout>
<style>
  .design-guides { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 20px; }
  .design-guides h2 { font-size: 1.65rem; letter-spacing: -.04em; }.design-guides p { max-width: 49ch; }
  .design-examples { margin-top: 90px; }.design-examples .section-heading > .lead { max-width: 38ch; font-size: .95rem; }
  .design-example-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .design-example { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--paper); }
  .design-example-image { display: flex; justify-content: center; padding: 30px 15px; background: var(--apricot); }
  .design-example:nth-child(2) .design-example-image { background: var(--lilac); }.design-example:nth-child(3) .design-example-image { background: var(--sage); }
  .design-example-image img { width: 200px; height: 228px; max-width: 100%; object-fit: contain; image-rendering: pixelated; }
  .design-example > div { padding: 24px; }.design-example h3 { font-size: 1.45rem; }.design-example h3 a { text-decoration: none; }.design-example h3 a:hover { text-decoration: underline; }
  .design-example p { color: var(--muted); font-size: .85rem; margin-top: 14px; }
  @media (max-width: 900px) { .design-example-grid { gap: 16px; }.design-example > div { padding: 20px; }.design-example-image { padding-inline: 10px; } }
  @media (max-width: 750px) { .design-example-grid { grid-template-columns: 1fr; }.design-example { display: grid; grid-template-columns: 230px 1fr; align-items: center; }.design-example-image { padding: 25px 15px; }.design-examples { margin-top: 60px; } }
  @media (max-width: 650px) { .design-guides { grid-template-columns: 1fr; }.design-guides h2 { font-size: 1.55rem; }.design-example { display: block; }.design-example-image { padding: 30px; } }
</style>
