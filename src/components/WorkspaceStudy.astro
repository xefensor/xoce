---
import Icon from './Icon.astro';
---
<div class="workspace-study" data-workspace>
  <div class="workspace-toolbar"><span><span class="status-dot"></span> Interaction study</span><button class="text-button" data-workspace-reset>Tidy workspace <Icon name="grid" size={15} /></button></div>
  <div class="workspace-canvas" data-workspace-canvas>
    <div class="workspace-note" data-window="notes" tabindex="0" aria-label="Notes window. Drag or use arrow keys to move."><div class="window-title"><span>01 / A thought</span><span aria-hidden="true">⠿</span></div><p>What if your tools<br />made a little<br /><em>more sense?</em></p><span class="window-footnote">Keep the question close.</span></div>
    <div class="workspace-reference" data-window="reference" tabindex="0" aria-label="Reference window. Drag or use arrow keys to move."><div class="window-title"><span>02 / A reference</span><span aria-hidden="true">⠿</span></div><div class="reference-drawing" aria-hidden="true"><span></span><span></span><span></span></div><p>Something worth<br />looking at differently.</p></div>
    <div class="workspace-action" data-window="action" tabindex="0" aria-label="Next step window. Drag or use arrow keys to move."><div class="window-title"><span>03 / A next step</span><span aria-hidden="true">⠿</span></div><Icon name="arrow" size={32} /><p>Try the idea.<br />See how it feels.</p></div>
    <span class="workspace-coordinate" aria-hidden="true">A SMALL SPACE FOR POSSIBILITY</span>
  </div>
  <p class="workspace-caption" data-workspace-status aria-live="polite">Drag a window, or focus one and use the arrow keys. Tidy workspace resets the layout.</p>
  <noscript><p class="workspace-caption">This is a static view of the study. Enable JavaScript to move and arrange the windows.</p></noscript>
</div>
<script>
  const study = document.querySelector<HTMLElement>('[data-workspace]');
  const canvas = study?.querySelector<HTMLElement>('[data-workspace-canvas]');
  const windows = [...(study?.querySelectorAll<HTMLElement>('[data-window]') ?? [])];
  const status = study?.querySelector<HTMLElement>('[data-workspace-status]');
  const positions = new Map<HTMLElement, { x: number; y: number }>();
  let top = 3;
  function place(el: HTMLElement, x: number, y: number) { if (!canvas) return; const value = { x: Math.max(8, Math.min(x, canvas.clientWidth - el.offsetWidth - 8)), y: Math.max(8, Math.min(y, canvas.clientHeight - el.offsetHeight - 8)) }; positions.set(el, value); el.style.left = `${value.x}px`; el.style.top = `${value.y}px`; }
  function reset() { if (!canvas) return; const narrow = canvas.clientWidth < 550; windows.forEach((el, i) => { const xs = narrow ? [12, .18 * canvas.clientWidth, .32 * canvas.clientWidth] : [36, .39 * canvas.clientWidth, .68 * canvas.clientWidth]; const ys = narrow ? [20, 148, 292] : [35, 92, 45]; place(el, xs[i], ys[i]); el.style.zIndex = String(i + 1); }); if (status) status.textContent = 'Drag a window, or focus one and use the arrow keys. Tidy workspace resets the layout.'; }
  for (const el of windows) {
    el.addEventListener('pointerdown', event => { if (event.button !== 0 || (event.pointerType === 'touch' && !(event.target as HTMLElement).closest('.window-title'))) return; const initial = positions.get(el); if (!initial) return; el.style.zIndex = String(++top); el.setPointerCapture(event.pointerId); el.dataset.dragging = ''; const start = { x: event.clientX, y: event.clientY }; const move = (e: PointerEvent) => place(el, initial.x + e.clientX - start.x, initial.y + e.clientY - start.y); const stop = () => { delete el.dataset.dragging; el.removeEventListener('pointermove', move); el.removeEventListener('pointerup', stop); el.removeEventListener('pointercancel', stop); if (status) status.textContent = 'Your workspace, arranged your way. Use Tidy workspace to start again.'; }; el.addEventListener('pointermove', move); el.addEventListener('pointerup', stop); el.addEventListener('pointercancel', stop); });
    el.addEventListener('keydown', event => { const directions: Record<string, number[]> = { ArrowLeft: [-12, 0], ArrowRight: [12, 0], ArrowUp: [0, -12], ArrowDown: [0, 12] }; const direction = directions[event.key]; const p = positions.get(el); if (!direction || !p) return; event.preventDefault(); el.style.zIndex = String(++top); place(el, p.x + direction[0], p.y + direction[1]); if (status) status.textContent = 'Window moved. Use Tidy workspace to reset.'; });
  }
  study?.querySelector('[data-workspace-reset]')?.addEventListener('click', reset);
  if (canvas) { new ResizeObserver(reset).observe(canvas); reset(); }
</script>
