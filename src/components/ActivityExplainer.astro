---
import { sitePath } from '../lib/site';
import { consumerProjects } from '../data/projects';
import { screenshotGalleries } from '../data/screenshots';
import Icon from './Icon.astro';
interface Props { product?: string }
const { product } = Astro.props;
const connections: Record<string, { title: string; text: string; detail: string; links: string[]; guide: string; label: string }> = {
  dynamic: {
    title: 'Leave Timer. Keep the countdown.',
    text: 'Start a countdown in Timer and return to Dynamic. Its remaining time can appear beneath your clock as an activity: an ongoing update from a compatible app.',
    detail: 'Timer still runs the countdown and handles the alarm. Open Timer to pause or resume it. Open Activity can add an optional button shortcut back.',
    links: ['timer', 'open-activity'], guide: '/docs/pebble/activities/', label: 'Try a countdown on Dynamic',
  },
  halftone: {
    title: 'Your countdown, beside your clock.',
    text: 'Start a countdown in Timer, then return to Halftone. An activity keeps the time remaining in view below your readings, with room for a second, smaller update.',
    detail: 'Timer still runs the countdown and handles the alarm. Open Timer to change it, or add Open Activity as an optional shortcut back.',
    links: ['timer', 'open-activity'], guide: '/docs/pebble/activities/', label: 'Try a countdown on Halftone',
  },
  timer: {
    title: 'Take your countdown to your clock.',
    text: 'Add Dynamic or Halftone to see the time remaining after you leave Timer. This shared update is called an activity. Dashboard can also show it in its overview.',
    detail: 'Sharing is optional. Timer keeps its countdown and successfully scheduled alarm on the watch, even without a connected phone.',
    links: ['dynamic', 'halftone', 'dashboard'], guide: '/docs/pebble/activities/', label: 'Show Timer on a watchface',
  },
  dashboard: {
    title: 'A different view of the same countdown.',
    text: 'Start a countdown in Timer and open Dashboard to see it in the overview. Hold Up for the full Activities list. Dashboard keeps its own activity order, separate from your watchface.',
    detail: 'Open Timer to pause or resume the countdown. Dashboard displays its activity but does not provide those timer controls.',
    links: ['timer'], guide: '/docs/pebble/setup/#dashboard', label: 'Choose your Dashboard sources',
  },
  'open-activity': {
    title: 'Back to the app, with a button.',
    text: 'With a countdown visible on Dynamic or Halftone, your configured Quick Launch shortcut can open Timer. It follows the Primary or Secondary activity you chose.',
    detail: 'The shortcut opens the whole app, not a particular saved timer. A missing or expired activity leaves it without an app to open.',
    links: ['dynamic', 'halftone', 'timer'], guide: '/docs/pebble/setup/#open-activity', label: 'Set up your Quick Launch shortcut',
  },
  'chmu-weather': {
    title: 'Weather in the places you already look.',
    text: 'Choose ČHMÚ Weather as your provider for Pebble Weather. To show small readings on Dynamic or Halftone, select them under Pebble’s Complications settings. Dashboard can display a reading as a pin.',
    detail: 'Weather readings have their own settings, separate from Activities such as a Timer countdown. Coverage is limited to Czech locations; UV is a forecast.',
    links: ['dynamic', 'halftone', 'dashboard'], guide: '/docs/pebble/chmu-weather/', label: 'Set up your weather source',
  },
};
const connection = product ? connections[product] : undefined;
const examples = [
  { slug: 'timer', title: 'Set your timer', text: 'Choose a duration with the watch buttons.', image: 'Set the duration' },
  { slug: 'dynamic', title: 'See it on Dynamic', text: 'Return to your everyday clock.', image: 'Timer and music Activities' },
].map(example => ({ ...example, capture: screenshotGalleries[example.slug].find(s => s.title === example.image && s.platform === 'gabbro')! }));
---
{connection ? <section class="activity-connection" aria-labelledby="connection-title">
  <div><p class="eyebrow">{product === 'chmu-weather' ? 'Choose your readings' : 'Connect the pieces you choose'}</p><h2 id="connection-title">{connection.title}</h2><p>{connection.text}</p><p>{connection.detail}</p></div>
  <aside class="connection-next" aria-label="Related apps and setup">
    <p class="eyebrow">{product === 'chmu-weather' ? 'Compatible with' : 'Works with'}</p>
    <div class="connection-products">{connection.links.map(slug => <a href={sitePath(`/projects/${slug}/`)}>{consumerProjects.find(p => p.slug === slug)!.name}<Icon name="arrow" size={15}/></a>)}</div>
    <p class="connection-requirement">{product === 'chmu-weather' ? 'Needs internet access and plugin support in the official Pebble phone app.' : 'Shared updates need the official Pebble phone app’s plugin support, source permissions and a connected phone.'}</p>
    <a class="text-link" href={sitePath(connection.guide)}>{connection.label}<Icon name="arrow" size={16}/></a>
  </aside>
</section> : <section class="activity-showcase" aria-labelledby="activities-title">
  <header class="section-heading"><div><p class="eyebrow">Better together</p><h2 id="activities-title">Start in Timer.<br/>Keep it on your clock.</h2></div><p>A countdown can stay in view after you leave its app. These ongoing updates are called <strong>Activities</strong>. Dynamic and Halftone can both display them.</p></header>
  <ol class="activity-example">{examples.map((example, index) => <li>
    <div class="activity-example-copy"><span aria-hidden="true">0{index + 1}</span><div><h3><a href={sitePath(`/projects/${example.slug}/`)}>{example.title}</a></h3><p>{example.text}</p></div></div>
    <figure><img src={sitePath(example.capture.image)} width={example.capture.width} height={example.capture.height} alt={example.capture.alt} loading="lazy" decoding="async"/><figcaption>v{example.capture.version} · Round 2 native emulator<br/>Separate example captures</figcaption></figure>
  </li>)}</ol>
  <div class="activity-example-notes"><div><p><strong>Timer still runs the countdown and handles the alarm.</strong> Shared updates need plugin support, source permissions and a connected phone. Music and notification integration needs Android.</p><a class="text-link" href={sitePath('/docs/pebble/activities/#try-a-timer-on-your-watchface')}>Try it step by step<Icon name="arrow" size={16}/></a></div><div><p>Want a shortcut back? <a href={sitePath('/projects/open-activity/')}>Open Activity</a> can open Timer from a configured Quick Launch shortcut. Add it when you need it.</p><a class="text-link" href={sitePath('/docs/pebble/activities/')}>How Activities work<Icon name="arrow" size={16}/></a></div></div>
</section>}
