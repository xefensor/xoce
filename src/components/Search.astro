---
import Icon from './Icon.astro';
---
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-heading">
  <div class="search-dialog-heading"><h2 id="search-heading">Search XOCE</h2><button class="icon-button" data-search-close aria-label="Close search"><Icon name="close" /></button></div>
  <label class="search-field"><Icon name="search" /><span class="sr-only">Search projects and documentation</span><input data-search-input type="search" placeholder="Projects, guides, activities…" autocomplete="off" spellcheck="false" /><button class="text-button" data-search-clear hidden>Clear</button></label>
  <p id="search-status" class="search-status" data-search-status aria-live="polite" aria-atomic="true">Search projects and documentation.</p>
  <div id="search-results" data-search-results class="search-results"></div>
  <button class="text-button" data-search-more aria-controls="search-results" aria-describedby="search-status" hidden>Show more results</button>
  <div class="search-help"><span>Software, guides and project plans</span><span><kbd>esc</kbd> to close</span></div>
</dialog>
<script>
  import { sitePath } from '../lib/site';
  import { getSearchPage, searchStatus, SEARCH_PAGE_SIZE } from '../lib/search.mjs';
  interface SearchEntry { title: string; description: string; href: string; section: string; text?: string }
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const more = document.querySelector<HTMLButtonElement>('[data-search-more]');
  let entries: SearchEntry[] | undefined;
  let loading: Promise<void> | undefined;
  let failed = false;
  let visibleCount = SEARCH_PAGE_SIZE;
  function render() {
    if (!results || !input || !status) return;
    const query = input.value.trim();
    if (clear) clear.hidden = !query;
    if (more) more.hidden = true;
    results.replaceChildren();
    if (!entries) { status.textContent = failed ? 'Search could not load. Close and reopen to retry, or use the Docs navigation.' : 'Loading search…'; return; }
    const { matches, total, hasMore } = getSearchPage(entries, query, visibleCount);
    status.textContent = searchStatus(query, matches.length, total);
    for (const entry of matches) {
      const link = document.createElement('a'); link.href = entry.href; link.className = 'search-result';
      const section = document.createElement('span'); section.className = 'eyebrow'; section.textContent = entry.section;
      const title = document.createElement('strong'); title.textContent = entry.title;
      const description = document.createElement('span'); description.textContent = entry.description;
      link.append(section, title, description); results.append(link);
    }
    if (more) {
      more.hidden = !hasMore;
      more.textContent = `Show ${Math.min(SEARCH_PAGE_SIZE, total - matches.length)} more results`;
    }
  }
  async function load() {
    if (entries) return;
    if (loading) return loading;
    failed = false;
    loading = (async () => { try { const response = await fetch(sitePath('/search.json')); if (!response.ok) throw new Error('Search unavailable'); entries = await response.json() as SearchEntry[]; } catch { failed = true; } finally { loading = undefined; render(); } })();
    return loading;
  }
  function open() { if (!dialog) return; if (!dialog.open) dialog.showModal(); input?.focus(); render(); void load(); }
  document.querySelectorAll('[data-search-open]').forEach(button => button.addEventListener('click', open));
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    event.preventDefault(); event.stopPropagation(); dialog?.close();
  });
  dialog?.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
  input?.addEventListener('input', () => { visibleCount = SEARCH_PAGE_SIZE; render(); });
  clear?.addEventListener('click', () => { if (input) { input.value = ''; visibleCount = SEARCH_PAGE_SIZE; input.focus(); render(); } });
  more?.addEventListener('click', () => {
    const firstNewResult = results?.childElementCount ?? 0;
    visibleCount += SEARCH_PAGE_SIZE;
    render();
    results?.querySelectorAll<HTMLAnchorElement>('a')[firstNewResult]?.focus();
  });
  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    if ((event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !target.closest('input, textarea, select, [contenteditable="true"]'))) { event.preventDefault(); open(); }
  });
</script>
