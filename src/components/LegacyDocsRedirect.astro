---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { section: 'guides' | 'developers' | 'design'; label: string; fragments?: Record<string, string> }
const { section, label, fragments = {} } = Astro.props;
const destination = { guides: '/docs/', developers: '/docs/develop/activities/', design: '/docs/design/principles/' }[section];
---
<BaseLayout title={`${label} — Docs`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href="/docs/" />
    <meta name="docs-destination" content={destination} data-fragments={JSON.stringify(fragments)} />
    <script is:inline>
      const config = document.querySelector('meta[name="docs-destination"]');
      const fragments = JSON.parse(config.dataset.fragments);
      const fragment = location.hash.slice(1);
      location.replace(Object.hasOwn(fragments, fragment) ? fragments[fragment] : config.content);
    </script>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
  </Fragment>
  <main id="main" class="wrap page-main">
    <h1>{label} is now in Docs</h1>
    <p><a href={destination}>Open {label.toLowerCase()} in Docs.</a></p>
  </main>
</BaseLayout>
