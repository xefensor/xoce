---
import { sitePath } from '../lib/site';
import type { Project } from '../data/projects';
import WatchPreview from './WatchPreview.astro';
import Icon from './Icon.astro';
import InstallActions from './InstallActions.astro';
interface Props { project: Project; wide?: boolean }
const { project } = Astro.props;
const plugin=project.kind==='plugin';
const platform=project.slug==='halftone'?'gabbro':'emery';
const preview=project.previews?.[platform];
---
<article class="launch-card" data-project-card data-project-kind={project.kind} data-project-platform={project.platform} data-project-availability={project.availability} data-project-downloadable={project.publication==='published'&&project.download?'true':'false'}>
  <a class="card-picture" href={sitePath(`/projects/${project.slug}/`)} aria-label={`Explore ${project.name}`}>
    {preview ? <WatchPreview image={preview.image} alt={preview.alt} platform={platform} framed={false} compact/> : project.image && <img class="plugin-icon" src={sitePath(project.image)} width="144" height="144" alt={project.imageAlt} loading="lazy"/>}
  </a>
  <div class="card-copy"><p class="eyebrow">{plugin?'Phone plugin':project.kind==='watchface'?'Watchface':'Watch app'}</p><h3>{project.storeArtwork&&<img class="product-family-mark" src={sitePath(project.storeArtwork.mark)} alt="" aria-hidden="true" width="36" height="36" loading="lazy"/>}<a href={sitePath(`/projects/${project.slug}/`)}>{project.name}</a></h3><p>{project.description}</p><p class="card-compatibility">{plugin?'Pebble phone app · Czech weather':'Time 2 + Round 2'}</p><InstallActions project={project} compact/><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>Explore {project.name}<Icon name="arrow" size={16}/></a></div>
</article>
