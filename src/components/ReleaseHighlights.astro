---
import type { Project } from '../data/projects';
import { highlightsForProject } from '../data/release-highlights';
import Icon from './Icon.astro';
interface Props { project: Project }
const { project } = Astro.props;
const highlights = highlightsForProject(project);
const releaseUrl = `${project.repo?.replace(/\/$/, '')}/releases/tag/${project.tag}`;
---
{highlights && <section class="release-highlights" aria-labelledby="release-highlights-title" data-release-highlights={project.slug} data-release-tag={project.tag}>
  <header>
    <p class="eyebrow">Latest release</p>
    <h2 id="release-highlights-title">What changed in v{project.version}</h2>
    <a class="release-notes-link" href={releaseUrl}>Full release notes<Icon name="external" size={15}/></a>
  </header>
  <ul>{highlights.changes.map(change => <li>{change}</li>)}</ul>
</section>}
<style>
  .release-highlights { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.2fr); gap:24px 60px; align-items:start; border-top:1px solid var(--line); padding:32px 0 36px; }
  .release-highlights header { border-inline-start:3px solid var(--product-accent,var(--accent)); padding-inline-start:18px; }
  .release-highlights h2 { font-size:clamp(1.5rem,2.4vw,1.9rem); line-height:1.2; margin-top:9px; }
  .release-notes-link { display:inline-flex; align-items:center; gap:8px; min-height:44px; margin-top:8px; color:var(--accent-text); font-size:.875rem; }
  .release-highlights ul { display:grid; gap:10px; margin:0; padding-inline-start:20px; font-size:.95rem; line-height:1.65; }
  .release-highlights li { padding-inline-start:3px; }
  @media (max-width:760px) {
    .release-highlights { grid-template-columns:minmax(0,1fr); gap:15px; padding:26px 0 30px; }
    .release-highlights header { padding-inline-start:14px; }
    .release-highlights ul { font-size:.9rem; }
  }
</style>
