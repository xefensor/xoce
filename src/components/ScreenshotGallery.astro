---
import { sitePath } from '../lib/site';
import { screenshotGalleries } from '../data/screenshots';
interface Props { slug: string; name: string }
const { slug, name } = Astro.props;
const screenshots = screenshotGalleries[slug] ?? [];
const groups = [
  { kind: 'watch', title: 'On the watch', note: 'Native Pebble Time 2 emulator captures from this release. Readings, messages and activities use example data.' },
  { kind: 'phone', title: 'Phone settings', note: 'Browser captures of the released settings page with example values. These are settings previews, not photographs of a phone or live weather.' },
];
---
{screenshots.length > 0 && <section id="screenshots" class="screenshots" aria-labelledby="screenshots-title">
  <header><p class="eyebrow">A closer look</p><h2 id="screenshots-title">{name} screenshots</h2><p>See the interface before you install. Open any image to view it at full size.</p></header>
  {groups.map(group => {
    const images = screenshots.filter(image => image.kind === group.kind);
    return images.length > 0 && <div class="screenshot-group">
      <h3>{group.title}</h3><p class="group-note">{group.note}</p>
      {group.kind === 'phone' && <p class="scroll-hint">Scroll inside a settings preview to see the whole page.</p>}
      <div class:list={['screenshot-grid', `screenshots-${group.kind}`]}>
        {images.map(image => <figure class="screenshot-card" data-screenshot={image.kind}>
          <div class:list={['screenshot-stage', { 'phone-stage': image.kind === 'phone' }]} tabindex={image.kind === 'phone' ? 0 : undefined} role={image.kind === 'phone' ? 'region' : undefined} aria-label={image.kind === 'phone' ? `${image.title}, scrollable preview` : undefined}>
            <a href={sitePath(image.image)} aria-label={`Open full-size image: ${image.title}`}><img src={sitePath(image.image)} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>
          </div>
          <figcaption><h4>{image.title}</h4><p>{image.caption}</p><div class="screenshot-meta"><span>v{image.version}</span><a href={sitePath(image.image)}>Full size</a><a href={image.source}>Source</a></div></figcaption>
        </figure>)}
      </div>
    </div>;
  })}
</section>}

<style>
  .screenshots { margin-top:52px; padding-top:36px; border-top:1px solid var(--line); scroll-margin-top:100px; }
  header h2 { margin-top:9px; font-size:clamp(1.7rem,3vw,2.2rem); letter-spacing:-.035em; }
  header > p:last-child,.group-note,.scroll-hint { max-width:74ch; margin-top:12px; color:var(--muted); font-size:.88rem; line-height:1.75; }
  .screenshot-group { margin-top:30px; }
  h3 { font-size:1.1rem; }
  .group-note { margin-top:8px; }
  .scroll-hint { font-size:.78rem; margin-top:5px; }
  .screenshot-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; margin-top:23px; }
  figure { min-width:0; margin:0; }
  .screenshot-stage { min-height:280px; display:flex; align-items:center; justify-content:center; padding:24px; background:var(--glass-surface); border:1px solid var(--line); border-radius:var(--radius-pane); }
  .screenshot-stage a { display:block; max-width:100%; }
  .screenshot-stage img { display:block; width:200px; max-width:100%; height:auto; image-rendering:pixelated; }
  .phone-stage { height:380px; min-height:0; padding:0; display:block; overflow:auto; overscroll-behavior:contain; scrollbar-gutter:stable; }
  .phone-stage img { width:100%; max-width:390px; margin-inline:auto; image-rendering:auto; }
  .screenshots-phone { grid-template-columns:repeat(2,minmax(0,390px)); }
  figcaption { padding-top:17px; }
  h4 { font-size:.96rem; line-height:1.4; }
  figcaption p { margin-top:8px; color:var(--muted); font-size:.81rem; line-height:1.7; }
  .screenshot-meta { display:flex; align-items:center; flex-wrap:wrap; gap:5px 18px; margin-top:8px; color:var(--muted); font-size:.74rem; }
  .screenshot-meta a { display:inline-flex; align-items:center; min-height:44px; }
  @media (max-width:900px) { .screenshot-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:25px; } }
  @media (max-width:560px) { .screenshot-grid { grid-template-columns:minmax(0,1fr); gap:30px; } .screenshot-stage { min-height:280px; } .phone-stage { min-height:0; height:380px; } .screenshots-phone { max-width:390px; } }
</style>
