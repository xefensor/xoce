---
import { sitePath } from '../lib/site';
import { screenshotGalleries } from '../data/screenshots';
interface Props { slug: string; name: string }
const { slug,name }=Astro.props;
const screenshots=screenshotGalleries[slug]??[];
const hasWatch=screenshots.some(s=>s.kind==='watch');
const groups=[{platform:'emery',title:'On Time 2'},{platform:'gabbro',title:'On Round 2'},{platform:'phone',title:'Phone settings'}];
---
{screenshots.length>0&&<section id="screenshots" class="launch-screenshots" aria-labelledby="screenshots-title"><header class="section-heading"><div><p class="eyebrow">A closer look</p><h2 id="screenshots-title">{name} in use.</h2></div><p>{hasWatch?'Actual app screens captured in the emulator with example data.':'Settings previews with example data.'} Open an image to see its full size.</p></header>
{groups.map(group=>{
 const images=screenshots.filter(s=>s.platform===group.platform);
 return images.length>0&&<div class="launch-screenshot-group"><h3>{group.title}</h3><div class="launch-screenshot-grid">{images.map(s=><figure data-screenshot={s.kind}><a class:list={['capture-stage',{'capture-round':s.platform==='gabbro','capture-phone':s.kind==='phone'}]} href={sitePath(s.image)} aria-label={`Open full-size image: ${s.title}`}><img src={sitePath(s.image)} width={s.width} height={s.height} alt={s.alt} loading="lazy" decoding="async"/></a><figcaption><strong>{s.title}</strong><span>{s.caption}</span><details class="capture-details"><summary>Capture details</summary><span>Captured v{s.version} · {s.kind==='phone'?'settings preview':'native emulator'}</span>{s.representedReleaseVersion && s.representedReleaseVersion!==s.version && <span>Reused for v{s.representedReleaseVersion} after native compatibility checks.</span>}<a href={sitePath(s.source)}>Capture provenance</a></details></figcaption></figure>)}</div></div>;
})}</section>}
