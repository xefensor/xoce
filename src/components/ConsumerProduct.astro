---
import type { Project } from '../data/projects';
import { projects } from '../data/projects';
import { sitePath } from '../lib/site';
import ShapePreview from './ShapePreview.astro';
import InstallActions from './InstallActions.astro';
import ScreenshotGallery from './ScreenshotGallery.astro';
import Icon from './Icon.astro';
import ActivityExplainer from './ActivityExplainer.astro';
import ProductStory from './ProductStory.astro';
import PhoneWeatherPreview from './PhoneWeatherPreview.astro';
import ReleaseHighlights from './ReleaseHighlights.astro';
import ProductArtwork from './ProductArtwork.astro';
interface Props { project: Project }
const { project } = Astro.props;
const plugin=project.kind==='plugin';
const setup=plugin||project.slug==='halftone'?project.setupGuide:`/docs/pebble/setup/#${project.slug}`;
const related=projects.filter(p=>(project.optionalConnections??(project.slug==='timer'?['dynamic','halftone','dashboard']:project.kind==='watchface'?['timer','open-activity','chmu-weather']:[])).includes(p.slug));
---
<main id="main" class="wrap launch-product" data-product={project.slug}>
  <nav class="product-breadcrumb" aria-label="Breadcrumb"><a href={sitePath('/projects/')}>Software</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav>
  <section class="launch-product-hero" aria-labelledby="product-title">
    <div class="launch-product-copy launch-product-intro"><p class="eyebrow product-family-label">{project.storeArtwork&&<img src={sitePath(project.storeArtwork.mark)} alt="" aria-hidden="true" width="32" height="32"/>}{plugin?'Pebble phone plugin':project.kind==='watchface'?'Pebble watchface':'Pebble watch app'}</p><h1 id="product-title">{project.name}</h1><p class="product-purpose">{project.description}</p></div>
    <div class="launch-product-preview product-art-stage"><ProductArtwork slug={project.slug}/>{plugin?<PhoneWeatherPreview project={project}/>:<ShapePreview project={project}/>}</div>
    <div class="launch-product-copy launch-product-details"><p class="product-summary">{project.summary}</p>
      <InstallActions project={project}/>
      <dl class="launch-facts"><div><dt>Works with</dt><dd>{project.compatibility}</dd></div><div><dt>{project.publication === 'published' ? 'Version' : 'Preview version'}</dt><dd>{project.version}</dd></div></dl>
      {project.requirements && <ul class="product-requirements">{project.requirements.map(r=><li>{r}</li>)}</ul>}
    </div>
  </section>
  <ReleaseHighlights project={project}/>
  <ProductStory project={project}/>
  <ActivityExplainer product={project.slug}/>
  <ScreenshotGallery slug={project.slug} name={project.name}/>
  <section class="product-next" aria-labelledby="use-title"><div><p class="eyebrow">Already installed?</p><h2 id="use-title">Make {project.name} yours.</h2><p>Find the setup steps and controls, or get help with something that isn’t working.</p></div><nav aria-label={`${project.name} guides`}><a href={sitePath(setup??project.guide)}>Set up {project.name}<Icon name="arrow" size={17}/></a>{project.controlsGuide&&<a href={sitePath(project.controlsGuide)}>Watch controls<Icon name="arrow" size={17}/></a>}<a href={sitePath(project.supportUrl)}>Support and troubleshooting<Icon name="arrow" size={17}/></a><a href={sitePath(project.privacyUrl)}>Privacy and permissions<Icon name="arrow" size={17}/></a></nav></section>
  {related.length>0&&<section class="product-related"><h2>Works well with</h2><div>{related.map(p=><a href={sitePath(`/projects/${p.slug}/`)}><strong>{p.name}</strong><span>{p.description}</span><Icon name="arrow" size={17}/></a>)}</div></section>}
  <div class="product-source"><a href={sitePath('/docs/develop/building/')}>Build from source</a>{project.developerGuide&&<a href={sitePath(project.developerGuide)}>Integration guide</a>}<a href={project.repo}>Source code<Icon name="external" size={14}/></a><a href={project.repo+'/releases'}>GitHub releases<Icon name="external" size={14}/></a>{project.licence&&<a href={project.licence.url}>{project.licence.name}</a>}</div>
</main>
