---
import type { Project } from '../data/projects';
import { sitePath } from '../lib/site';
import Icon from './Icon.astro';
interface Props { project: Project; compact?: boolean }
const { project, compact = false } = Astro.props;
const published = project.publication === 'published' && !!project.storeUrl;
---
<div class:list={['install-actions', { 'install-compact': compact }]} data-install-state={published ? 'published' : 'preview'}>
  {published ? <a class="button button-primary" href={project.storeUrl}>View in Pebble Store<Icon name="external" size={16}/></a> : <span class="install-pending">Store release in preparation</span>}
  {!compact && <a class="text-link" href={sitePath(project.kind==='plugin'||project.slug==='halftone'?project.setupGuide??project.guide:`/docs/pebble/setup/#${project.slug}`)}>Install and set up<Icon name="arrow" size={16}/></a>}
  {published && project.download && <a class="text-link manual-download" href={project.download}>Download .pbw · v{project.version}<Icon name="download" size={16}/></a>}
</div>
