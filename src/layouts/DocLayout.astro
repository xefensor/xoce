---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { docs, docSections } from '../data/docs';
interface Props { frontmatter: { title: string; description: string; section: string; order?: number }; headings?: { depth: number; slug: string; text: string }[] }
const { frontmatter, headings = [] } = Astro.props;
const path = Astro.url.pathname;
const current = docs.find(doc => doc.href === path);
const section = docSections.find(section => section.title === (current?.section ?? frontmatter.section)) ?? docSections[0];
const guides = docs.filter(doc => doc.section === section.title);
const index = guides.findIndex(doc => doc.href === path);
const previous = index > 0 ? guides[index - 1] : undefined;
const next = index >= 0 ? guides[index + 1] : undefined;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} bodyClass="docs-page">
  <div class="docs-shell wrap">
    <details class="docs-mobile-nav"><summary>Browse {section.title === 'Design' ? 'design' : section.title === 'For developers' ? 'developer' : 'user'} guides</summary><nav aria-label="Mobile documentation navigation"><a href={section.href}>{section.title} overview</a>{guides.map(doc => <a href={doc.href} aria-current={path === doc.href ? 'page' : undefined}>{doc.title}</a>)}<a href="/docs/">All guides</a></nav></details>
    <aside class="docs-sidebar">
      <a class="docs-home" href={section.href}><Icon name={section.icon} size={18} /> {section.title}</a>
      <nav aria-label="Documentation navigation"><div class="docs-group">{guides.map(doc => <a href={doc.href} aria-current={path === doc.href ? 'page' : undefined}>{doc.title}</a>)}</div></nav>
      <nav class="docs-other-sections" aria-label="Other documentation sections"><p class="eyebrow">Also on XOCE</p>{docSections.filter(other => other.title !== section.title).map(other => <a href={other.href}>{other.title}<Icon name="arrow" size={14} /></a>)}<a href="/docs/">All guides<Icon name="book" size={14} /></a></nav>
    </aside>
    <main id="main" class="doc-main">
      <div class="breadcrumb"><a href={section.href}>{section.title}</a><Icon name="chevron" size={12} /><span>Guide</span></div>
      <header class="doc-heading"><span class="eyebrow">{section.title}</span><h1>{frontmatter.title}</h1><p class="lead">{frontmatter.description}</p></header>
      <article class="prose"><slot /></article>
      <nav class="doc-pagination" aria-label="Previous and next guides">{previous ? <a href={previous.href}><span>Previous guide</span><strong>{previous.title}</strong></a> : <span />}{next ? <a href={next.href}><span>Next guide <Icon name="arrow" size={14} /></span><strong>{next.title}</strong></a> : <a href={section.href}><span>Back to</span><strong>{section.title}</strong></a>}</nav>
    </main>
    {headings.some(heading => heading.depth === 2) && <aside class="docs-toc"><span class="eyebrow">On this page</span>{headings.filter(heading => heading.depth === 2).map(heading => <a href={'#' + heading.slug}>{heading.text}</a>)}</aside>}
  </div>
</BaseLayout>
