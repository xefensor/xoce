---
import BaseLayout from './BaseLayout.astro';
import { projects } from '../data/projects';
import { sitePath } from '../lib/site';
const { frontmatter }=Astro.props;
const project=projects.find(p=>p.slug===frontmatter.project)!;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
<main id="main" class="wrap policy-page"><a class="text-link" href={sitePath(`/projects/${project.slug}/`)}>← {project.name}</a><h1>{frontmatter.title}</h1><p class="policy-version">{project.name} v{project.version} · {project.publication==='preview'?'launch preview':'published release'}</p><article class="policy-body"><slot/></article><p class="image-caption">Based on the app-owned documentation. <a href={project.repo}>Project source</a> · <a href={sitePath(`/projects/${project.slug}/privacy/`)}>Privacy</a> · <a href={sitePath(`/projects/${project.slug}/support/`)}>Support</a></p></main>
</BaseLayout>
