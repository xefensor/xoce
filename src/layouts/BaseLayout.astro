---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
interface Props { title?: string; description?: string; bodyClass?: string }
const { title = 'XOCE', description = 'Pebble apps, watchfaces and developer libraries from Xef’s Open Computing Ecosystem. Downloads, setup guides and design documentation.', bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ec" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title === 'XOCE' ? 'XOCE — Xef’s Open Computing Ecosystem' : `${title} — XOCE`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <noscript><link rel="stylesheet" href="/no-js.css" /></noscript>
    <title>{title === 'XOCE' ? 'XOCE — Xef’s Open Computing Ecosystem' : `${title} — XOCE`}</title>
    <script is:inline>
      (() => { let saved; try { saved = localStorage.getItem('xoce-theme'); } catch {} document.documentElement.dataset.theme = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <Search />
  </body>
</html>
