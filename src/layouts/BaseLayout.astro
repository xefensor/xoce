---
import { sitePath } from '../lib/site';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/launch.css';
import '../styles/identity.css';
import '../styles/product-art.css';
import { launchPreview } from '../data/projects';
import { siteOrigin } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
interface Props { title?: string; description?: string; bodyClass?: string; canonical?: string; socialImage?: string }
const { title = 'XOCE', description = 'Xef’s Open Computing Ecosystem: a project for everyday software on KDE Plasma, Android and PebbleOS. Try the current apps and see where the ecosystem is heading.', bodyClass = '', canonical = Astro.url.pathname, socialImage } = Astro.props;
const canonicalUrl = new URL(sitePath(canonical), siteOrigin).href;
---
<!doctype html>
<html lang="en" data-ui="material">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e8edf0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    {launchPreview && <meta name="robots" content="noindex,follow"/>}
    <meta property="og:url" content={canonicalUrl}/>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title === 'XOCE' ? 'XOCE — Xef’s Open Computing Ecosystem' : `${title} — XOCE`} />
    <meta property="og:description" content={description} />
    {socialImage && <><meta property="og:image" content={new URL(sitePath(socialImage), siteOrigin).href}/><meta property="og:image:width" content="720"/><meta property="og:image:height" content="320"/></>}
    <link rel="icon" type="image/svg+xml" href={sitePath('/images/identity/favicon.svg')} />
    <noscript><link rel="stylesheet" href={sitePath('/no-js.css')} /></noscript>
    <title>{title === 'XOCE' ? 'XOCE — Xef’s Open Computing Ecosystem' : `${title} — XOCE`}</title>
    <script is:inline>
      (() => { let saved; try { saved = localStorage.getItem('xoce-theme'); } catch {} const root = document.documentElement; root.dataset.theme = saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light'; document.querySelector('meta[name="theme-color"]')?.setAttribute('content', root.dataset.theme === 'dark' ? '#171d21' : '#e8edf0'); })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {launchPreview && <aside class="launch-banner" aria-label="Release status"><p class="wrap"><strong>Launch preview</strong><span>These releases are being prepared for Pebble Store.</span></p></aside>}
    <slot />
    <Footer />
    <Search />
  </body>
</html>
